{% render 'section-style', section: section %}
{%- comment -%}
  Bottle → dish, rebuilt against the design.

  "Already got the bottle. Now cook for it." Two selectors — bottle, then
  effort — and ONE recipe panel: method down the left, shopping list ruled off
  to the right, why it works beneath, and a "write me another" that rolls to a
  different effort for the same bottle.

  The first version rendered all thirty recipes into the page and hid
  twenty-nine with JS. Functionally the same, but it read as a wall of chunks
  rather than one dish — and with JS off it was thirty recipes stacked. Now the
  panel is a single slot the selectors fill.

  Recipes live in the non_recipe metaobject; see docs/recipes.md.
{%- endcomment -%}

{%- liquid
  assign recipes = section.settings.recipes.value | default: shop.metaobjects.non_recipe.values
  assign efforts = 'fast,sunday,showoff,aperitivo,sweet' | split: ','
-%}

<div class="non-section" data-non-recipes style="border-top:1px solid var(--non-line)">
  <div class="non-section__head">
    <h2 class="non-section__title">{{ section.settings.heading }}</h2>
    <span class="non-section__more">{{ section.settings.subheading }}</span>
  </div>

  {%- if recipes.size > 0 -%}
    {%- comment -%} bottle picker {%- endcomment -%}
    <div class="non-mono non-eyebrow" style="margin-top:26px">The bottle</div>
    <div class="non-filters" role="group" aria-label="Choose a bottle">
      {%- assign seen = '' -%}
      {%- for recipe in recipes -%}
        {%- liquid
          assign bottle = recipe.bottle.value
          assign key = bottle.handle
          assign marker = '|' | append: key | append: '|'
        -%}
        {%- if key != blank and seen contains marker == false -%}
          {%- assign seen = seen | append: marker -%}
          {%- capture bcode %}{% render 'non-code', product: bottle %}{% endcapture -%}
          <button
            type="button"
            class="non-filter"
            data-non-recipe-bottle="{{ key }}"
            aria-pressed="false">
            {{ bcode | strip }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} effort picker {%- endcomment -%}
    <div class="non-mono non-eyebrow" style="margin-top:20px">Effort</div>
    <div class="non-filters" role="group" aria-label="How much effort">
      {%- for effort in efforts -%}
        <button
          type="button"
          class="non-filter"
          data-non-recipe-effort="{{ effort }}"
          aria-pressed="false">
          {%- case effort -%}
            {%- when 'fast' -%}Weeknight
            {%- when 'sunday' -%}Sunday
            {%- when 'showoff' -%}Show off
            {%- when 'aperitivo' -%}Aperitivo
            {%- else -%}Cheese &amp; dessert
          {%- endcase -%}
        </button>
      {%- endfor -%}
    </div>

    {%- comment -%}
      Every recipe is rendered, but only one is ever visible. They are marked
      hidden in Liquid rather than by JS so the page never flashes all thirty.
    {%- endcomment -%}
    <div class="non-recipe__slot">
      {%- for recipe in recipes -%}
        {%- assign bottle = recipe.bottle.value -%}
        <article
          class="non-recipe"
          data-non-recipe
          data-bottle="{{ bottle.handle }}"
          data-effort="{{ recipe.effort | downcase | strip }}"
          hidden>
          <div class="non-recipe__main">
            <div class="non-mono non-eyebrow">{{ recipe.meta }}</div>
            <h3 class="non-recipe__title">{{ recipe.title }}</h3>
            <p class="non-buy__blurb">{{ recipe.intro }}</p>

            {%- if recipe.steps.value.size > 0 -%}
              <div class="non-mono non-eyebrow" style="margin-top:28px">Method</div>
              <ol class="non-steps" style="margin-top:16px;padding:0;list-style:none">
                {%- for step in recipe.steps.value -%}
                  <li class="non-step">
                    <div class="non-step__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
                    <p class="non-step__b" style="margin:0">{{ step }}</p>
                  </li>
                {%- endfor -%}
              </ol>
            {%- endif -%}

            {%- if recipe.why != blank -%}
              <div style="margin-top:28px;border-top:1px solid var(--non-line);padding-top:18px">
                <div class="non-spec__k">Why it works</div>
                <p class="non-step__b" style="max-width:52ch">{{ recipe.why }}</p>
              </div>
            {%- endif -%}

            <button type="button" class="non-btn non-btn--ghost" data-non-recipe-another style="margin-top:22px">
              Write me another
            </button>
          </div>

          <aside class="non-recipe__aside">
            {%- if recipe.image -%}
              {{
                recipe.image.value
                | image_url: width: 900, format: 'webp'
                | image_tag: loading: 'lazy', widths: '420,640,900', alt: recipe.title
              }}
            {%- endif -%}

            {%- if recipe.ingredients.value.size > 0 -%}
              <div class="non-mono non-eyebrow" style="margin-top:20px">Shopping list</div>
              <div style="margin-top:12px">
                {%- for line in recipe.ingredients.value -%}
                  {%- assign parts = line | split: ' — ' -%}
                  <div class="non-recipe__ing">
                    <span>{{ parts | first }}</span>
                    {%- if parts.size > 1 -%}<span class="non-card__note">{{ parts | last }}</span>{%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if bottle != blank -%}
              <div style="margin-top:22px">
                {% render 'product-card', product: bottle, show_add: true %}
              </div>
            {%- endif -%}
          </aside>
        </article>
      {%- endfor -%}

      <p class="non-note" data-non-recipe-empty hidden>
        No recipe written for that combination yet. Try another effort.
      </p>
    </div>
  {%- else -%}
    <p class="non-note" style="margin-top:24px">
      No recipes yet. Create <code>non_recipe</code> metaobject entries — see docs/recipes.md.
    </p>
  {%- endif -%}
</div>

<script src="{{ 'recipes.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Pairing recipes",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bottle → dish"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Already got the bottle. Now cook for it."
    },
    {
      "type": "metaobject_list",
      "id": "recipes",
      "label": "Recipes",
      "metaobject_type": "non_recipe",
      "info": "Leave empty to show every non_recipe entry."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "presets": [
    {
      "name": "Pairing recipes"
    }
  ]
}
{% endschema %}
