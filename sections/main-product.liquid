{% render 'section-style', section: section %}
{%- comment -%}
  Product page, rebuilt against the design (design-reference/product.html).

  Structure, in order:
    1. 50/50 gallery + buy box            (the design's `twoCols`, not a sidebar)
    2. spec strip — 4 cells, ruled top and bottom, divided
    3. process — numbered steps + ingredients | full-bleed process image
    4. pour it with — 3 bordered pairing cards
    5. goes well in a case with — horizontal related cards

  `render` is a standalone tag and cannot appear inside {% liquid %}, so every
  capture that wraps one sits outside the liquid block.
{%- endcomment -%}

{%- capture code %}{% render 'non-code', product: product %}{% endcapture -%}
{%- capture calories %}{% render 'non-nutrition', product: product, label: 'Calories per serve' %}{% endcapture -%}
{%- capture sugars %}{% render 'non-nutrition', product: product, label: 'Sugars - Total' %}{% endcapture -%}

{%- liquid
  assign m = product.metafields.custom
  assign code = code | strip
  assign calories = calories | strip
  assign sugars = sugars | strip

  assign tastes = m.profile | metafield_text | default: m.tastes | metafield_text
  assign sits = m.sits | metafield_text
  assign serve = m.serve | metafield_text | default: 'Chilled, wine glass'
  assign ingredients = m.ingredients | metafield_text
  assign style = m.style | metafield_text

  assign nutrition = ''
  if calories != blank and sugars != blank
    assign nutrition = calories | append: ' calories, ' | append: sugars | append: ' sugar'
  endif

  assign spec_count = 2
  if nutrition != blank
    assign spec_count = 3
  endif
  if sits != blank
    assign spec_count = spec_count | plus: 1
  endif
-%}

<div class="non-product" data-non-somm-root>
  {%- comment -%} ── gallery ───────────────────────────────────────────── {%- endcomment -%}
  <div class="non-gallery">
    {%- if product.media.size > 0 -%}
      {{
        product.featured_media
        | image_url: width: 1400, format: 'webp'
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600,900,1200,1400',
          class: 'non-gallery__main',
          data-non-gallery-main: '',
          alt: product.featured_media.alt
          | default: product.title
      }}

      {%- if product.media.size > 1 -%}
        <div class="non-gallery__thumbs">
          {%- for media in product.media limit: 8 -%}
            <button
              type="button"
              class="non-gallery__thumb"
              data-non-gallery-thumb
              data-full="{{ media | image_url: width: 1400, format: 'webp' }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="View image {{ forloop.index }}">
              <img src="{{ media | image_url: width: 200, format: 'webp' }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'non-gallery__main' }}
    {%- endif -%}
  </div>

  {%- comment -%} ── buy box ───────────────────────────────────────────── {%- endcomment -%}
  <div class="non-buy">
    <div>
      <div class="non-mono non-eyebrow">
        {{ code }}
        {%- if style != blank %} &middot; {{ style }}{% endif -%}
        {%- if section.settings.eyebrow_suffix != blank %} &middot; {{ section.settings.eyebrow_suffix }}{% endif -%}
      </div>

      <h1 class="non-buy__name">{{ product.title | remove: code | strip }}</h1>

      {%- if m.blurb != blank -%}
        <p class="non-buy__blurb">{{ m.blurb | metafield_text }}</p>
      {%- elsif m.profile != blank -%}
        <p class="non-buy__blurb">{{ m.profile | metafield_text }}</p>
      {%- endif -%}
    </div>

    <form method="post" action="{{ routes.cart_add_url }}" data-non-product-form>
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-non-variant-input>

      {%- if product.variants.size > 1 -%}
        <div class="non-variants" role="radiogroup" aria-label="Pack size">
          {%- for variant in product.variants -%}
            {%- liquid
              assign units = variant.metafields.custom.units | metafield_text | plus: 0
              if units == 0
                assign units = variant.title | plus: 0
              endif
              if units == 0
                assign units = 1
              endif
              assign each = variant.price | divided_by: units
            -%}
            <button
              type="button"
              class="non-variant"
              role="radio"
              data-non-variant
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price }}"
              aria-checked="{% if variant.id == product.selected_or_first_available_variant.id %}true{% else %}false{% endif %}"
              {% unless variant.available %}disabled{% endunless %}>
              <span class="non-variant__lines">
                <span class="non-variant__label">
                  {%- comment -%}
                    Pack names come from Pack label blocks, matched on the
                    variant title, so "6" can read "6 pack" without anyone
                    renaming variants in the product admin — variant titles are
                    shared with reporting and checkout and should stay plain.
                    Falls back to the variant's own title when no block matches.
                  {%- endcomment -%}
                  {%- liquid
                    assign pack_label = ''
                    for b in section.blocks
                      if b.type == 'pack' and b.settings.variant_title == variant.title
                        assign pack_label = b.settings.label
                        break
                      endif
                    endfor
                    if pack_label == blank and variant.title == 'Default Title'
                      assign pack_label = product.title
                    endif
                    if pack_label == blank
                      assign pack_label = variant.title
                    endif
                    echo pack_label
                  -%}
                </span>
                <span class="non-variant__per">
                  {%- if variant.available -%}
                    {{ each | money }} {{ section.settings.each_word }}
                    {%- if variant.compare_at_price > variant.price -%}
                      {%- assign save = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
                      &middot; {{ section.settings.save_word }} {{ save }}%
                    {%- endif -%}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
              </span>
              <span class="non-variant__price">{{ variant.price | money }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <input type="hidden" name="quantity" value="1">

      <button type="submit" class="non-atc" {% unless product.available %}disabled{% endunless %}>
        {%- if product.available -%}
          {{ section.settings.add_label }} &mdash; <span data-non-price>{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </button>

      {%- comment -%} The reassurance row from the design, under the button. {%- endcomment -%}
      <div class="non-buy__trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust' -%}
            <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="non-error" data-non-form-error></p>
    </form>

    {%- comment -%} ── somm, as a panel ────────────────────────────────── {%- endcomment -%}
    {%- if section.settings.show_somm -%}
      <div class="non-sommbox" style="{% if section.settings.somm_dot_colour != blank %}--non-somm-dot: {{ section.settings.somm_dot_colour }};{% endif %}{% if section.settings.somm_bg != blank %}--non-somm-bg: {{ section.settings.somm_bg }};{% endif %}{% if section.settings.somm_border != blank %}--non-somm-border: {{ section.settings.somm_border }};{% endif %}">
        {%- comment -%}
          One label, not two. The head printed the locale string "NON Somm" and
          the opening line printed section.settings.somm_title immediately below
          it — the same words twice, six lines apart. The setting now drives the
          single remaining label, so the panel is named in one place and that
          place is editable.
        {%- endcomment -%}
        <div class="non-sommbox__head">
          {%- comment -%}
            NOT `setting | default: 'key' | t`. Liquid applies `t` to whatever
            the chain produces, so a set value gets looked up as a translation
            key and renders "Translation missing: en.NON Somm". The locale
            string is only a fallback for when the setting is empty.
          {%- endcomment -%}
          <span class="non-mono non-eyebrow">
            {%- if section.settings.somm_title != blank -%}
              {{ section.settings.somm_title }}
            {%- else -%}
              {{ 'products.product.somm_heading' | t }}
            {%- endif -%}
          </span>
          <span class="non-sommbox__live">
            <span class="non-sommbox__dot" aria-hidden="true"></span>
            {{ section.settings.somm_status }}
          </span>
        </div>

        {%- comment -%}
          The opener was wrapped in .non-chat__msg--a, a chat bubble with its own
          border and background sitting inside the panel's border — a box in a
          box, with the bubble's min-height leaving a large empty area beneath
          three lines of text. It is not a message; nobody sent it. It reads as
          the panel's own standfirst, so it is one now.

          The transcript wrapper stays: somm.js appends real replies into it.
        {%- endcomment -%}
        <div class="non-sommbox__body" data-non-somm-transcript>
          <p class="non-sommbox__opener">{{ section.settings.somm_opener }}</p>
          <p class="non-somm__stream" data-non-somm-stream hidden></p>
        </div>

        <form
          class="non-sommbox__ask"
          data-non-somm
          data-somm-context="product"
          data-somm-code="{{ code }}">
          <label class="visually-hidden" for="somm-p-{{ section.id }}">{{ section.settings.somm_placeholder }}</label>
          <input
            id="somm-p-{{ section.id }}"
            class="non-somm__input"
            type="search"
            autocomplete="off"
            data-non-somm-input
            placeholder="{{ section.settings.somm_placeholder | escape }}">
          <button type="submit" class="non-sommbox__submit">{{ 'products.product.ask' | t }}</button>
        </form>

        {%- assign seeds = section.blocks | where: 'type', 'seed' -%}
        {%- if seeds.size > 0 -%}
          <div class="non-sommbox__seeds">
            {%- for block in seeds -%}
              <button
                type="button"
                class="non-somm__seed"
                data-non-somm-seed
                data-answer="{{ block.settings.answer | escape }}"
                {{ block.shopify_attributes }}>
                {{ block.settings.label }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="non-somm__answer" data-non-somm-answer hidden>
          <div class="non-somm__picks" data-non-somm-picks hidden></div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%} ── spec strip ────────────────────────────────────────────── {%- endcomment -%}
{%- comment -%}
  Block-driven. This was four fixed settings — spec_tastes, spec_sits,
  spec_nutrition, spec_serve — which meant the labels were editable but the
  strip itself was not: you could not add a fifth row, drop one you did not
  want, or change their order without editing Liquid.

  Each block carries a label and a SOURCE, because the values come from product
  metafields rather than from the theme. `custom` is there so a row can be
  written by hand for a product that has no metafield for it.

  A row whose source resolves to nothing is skipped rather than rendered empty,
  which is what the old `if sits != blank` guards were doing by hand. The count
  is derived from what actually rendered, so the layout modifier stays honest.

  If no spec blocks exist the four original settings still render, so a template
  that has not been migrated looks exactly as it did before.
{%- endcomment -%}
{%- assign specs = section.blocks | where: 'type', 'spec' -%}

{%- if specs.size > 0 -%}
  {%- capture spec_cells -%}
    {%- for block in specs -%}
      {%- liquid
        assign val = ''
        case block.settings.source
          when 'tastes'
            assign val = tastes | default: product.title
          when 'sits'
            assign val = sits
          when 'nutrition'
            assign val = nutrition
          when 'serve'
            assign val = serve
          when 'custom'
            assign val = block.settings.custom_value
          else
            assign val = block.settings.custom_value
        endcase
      -%}
      {%- if val != blank -%}
        <div class="non-specstrip__cell" {{ block.shopify_attributes }}>
          <div class="non-spec__k">{{ block.settings.label }}</div>
          <div class="non-specstrip__v">{{ val }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- assign rendered_count = spec_cells | split: 'non-specstrip__cell' | size | minus: 1 -%}
  {%- if rendered_count > 0 -%}
    <div class="non-specstrip non-specstrip--{{ rendered_count }}">{{ spec_cells }}</div>
  {%- endif -%}

{%- else -%}
  <div class="non-specstrip non-specstrip--{{ spec_count }}">
    <div class="non-specstrip__cell">
      <div class="non-spec__k">{{ section.settings.spec_tastes }}</div>
      <div class="non-specstrip__v">{{ tastes | default: product.title }}</div>
    </div>

    {%- if sits != blank -%}
      <div class="non-specstrip__cell">
        <div class="non-spec__k">{{ section.settings.spec_sits }}</div>
        <div class="non-specstrip__v">{{ sits }}</div>
      </div>
    {%- endif -%}

    {%- if nutrition != blank -%}
      <div class="non-specstrip__cell">
        <div class="non-spec__k">{{ section.settings.spec_nutrition }}</div>
        <div class="non-specstrip__v">{{ nutrition }}</div>
      </div>
    {%- endif -%}

    <div class="non-specstrip__cell">
      <div class="non-spec__k">{{ section.settings.spec_serve }}</div>
      <div class="non-specstrip__v">{{ serve }}</div>
    </div>
  </div>
{%- endif -%}

{%- comment -%}
  The bottle's own spec sheet, for the Somm.

  The panel's opening line promises "I've read the whole spec sheet for this
  bottle" and until now the request carried only a product CODE — so a question
  like "how long will it last after I open it?" had nothing behind it to answer
  from. The fact was already in Shopify on every bottle (custom.storage); it was
  simply never sent.

  Only fields that already exist and are already shown to a customer somewhere
  on this page, so this adds no new claim — it hands the Somm the same sheet the
  page is printing.
{%- endcomment -%}
<script type="application/json" data-non-somm-facts>
  {
    "code": {{ code | json }},
    "title": {{ product.title | json }},
    "price": {{ product.selected_or_first_available_variant.price | money | json }},
    "profile": {{ tastes | default: '' | json }},
    "sits": {{ sits | default: '' | json }},
    "serve": {{ serve | default: '' | json }},
    "ingredients": {{ ingredients | default: '' | json }},
    "storage": {{ m.storage | metafield_text | default: '' | json }},
    "notes": {{ m.notes | metafield_text | default: '' | json }},
    "nutrition": {{ nutrition | default: '' | json }},
    "available": {{ product.available | json }}
  }
</script>

<script type="application/json" data-non-catalogue>
  {
    {%- assign seen = '' -%}
    {%- for p in collections['the-range'].products -%}
      {%- capture c %}{% render 'non-code', product: p %}{% endcapture -%}
      {%- assign c = c | strip -%}
      {%- assign marker = '|' | append: c | append: '|' -%}
      {%- unless seen contains marker -%}
        {%- assign seen = seen | append: marker -%}
        {%- unless forloop.first %},{% endunless -%}
        {{ c | json }}: {
          "title": {{ p.title | json }},
          "url": {{ p.url | json }},
          "image": {{ p.featured_image | image_url: width: 200, format: 'webp' | json }},
          "price": {{ p.price | money | json }},
          "note": {{ p.metafields.custom.profile | metafield_text | default: '' | truncate: 44 | json }},
          "variantId": {{ p.selected_or_first_available_variant.id | json }},
          "available": {{ p.available | json }}
        }
      {%- endunless -%}
    {%- endfor -%}
  }
</script>

<script src="{{ 'somm.js' | asset_url }}" defer></script>
<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_somm",
      "label": "Show the somm in the buy box",
      "default": true
    },
    {
      "type": "textarea",
      "id": "somm_opener",
      "label": "Somm opening line",
      "default": "I've read the whole spec sheet for this bottle. Ask me anything — pairing, process, sugar, or whether it's right for you."
    },
    {
      "type": "text",
      "id": "somm_title",
      "label": "Somm panel title",
      "default": "NON Somm"
    },
    {
      "type": "text",
      "id": "somm_status",
      "label": "Somm status label",
      "default": "Somm live"
    },
    {
      "type": "color",
      "id": "somm_dot_colour",
      "label": "Live dot colour",
      "default": "#4ade80",
      "info": "The one deliberate colour on an otherwise monochrome site. Set it to white to remove the exception."
    },
    {
      "type": "color",
      "id": "somm_bg",
      "label": "Somm box background",
      "info": "The panel behind the somm. Leave empty for the theme default."
    },
    {
      "type": "color",
      "id": "somm_border",
      "label": "Somm box border"
    },
    {
      "type": "text",
      "id": "somm_placeholder",
      "label": "Somm input placeholder",
      "default": "Ask about this bottle"
    },
    {
      "type": "header",
      "content": "Buy box"
    },
    {
      "type": "text",
      "id": "eyebrow_suffix",
      "label": "Eyebrow suffix",
      "default": "0.0% ABV · 750ml",
      "info": "Follows the bottle code and style."
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add"
    },
    {
      "type": "text",
      "id": "each_word",
      "label": "Per-unit word",
      "default": "each"
    },
    {
      "type": "text",
      "id": "save_word",
      "label": "Saving word",
      "default": "save"
    },
    {
      "type": "header",
      "content": "Spec strip"
    },
    {
      "type": "text",
      "id": "spec_tastes",
      "label": "Tastes label",
      "default": "Tastes like",
      "info": "Legacy. Used only when the section has no Spec row blocks. Add Spec rows to control the strip."
    },
    {
      "type": "text",
      "id": "spec_sits",
      "label": "Sits label",
      "default": "Sits where"
    },
    {
      "type": "text",
      "id": "spec_nutrition",
      "label": "Nutrition label",
      "default": "Per 150ml"
    },
    {
      "type": "text",
      "id": "spec_serve",
      "label": "Serve label",
      "default": "Serve"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Reassurance",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "seed",
      "name": "Suggested question",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    },
    {
      "type": "pack",
      "name": "Pack label",
      "settings": [
        {
          "type": "text",
          "id": "variant_title",
          "label": "Variant title",
          "info": "Exactly as it appears on the product, e.g. 6"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Shown as",
          "default": "6 pack"
        }
      ]
    },
    {
      "type": "spec",
      "name": "Spec row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Tastes"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Value from",
          "default": "tastes",
          "info": "Where the value comes from. Metafield sources render nothing when the product has no value, and the row is skipped.",
          "options": [
            {
              "value": "tastes",
              "label": "Flavour profile (metafield)"
            },
            {
              "value": "sits",
              "label": "Sits with (metafield)"
            },
            {
              "value": "nutrition",
              "label": "Nutrition (calories + sugar)"
            },
            {
              "value": "serve",
              "label": "How to serve (metafield)"
            },
            {
              "value": "custom",
              "label": "Custom text"
            }
          ]
        },
        {
          "type": "text",
          "id": "custom_value",
          "label": "Custom text",
          "info": "Used only when Value from is set to Custom text."
        }
      ]
    }
  ],
  "max_blocks": 30
}
{% endschema %}
