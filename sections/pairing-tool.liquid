{% render 'section-style', section: section %}
{%- comment -%}
  Pairing — food → bottle.

  Three axes, each option carrying a score per bottle code. Scores are summed
  and the leading bottle wins, with a running "trace" that shows the reasoning
  rather than just the answer. The reverse flow (bottle → recipe) is a separate
  section, pairing-recipes.
{%- endcomment -%}

{%- comment -%}
  The design leads with a statement, and treats each question as a bold
  numbered heading. The port opened with an 11px eyebrow and replaced the
  numbered headings with a 'question 1 of 6' counter and progress dashes,
  which reads like a survey tool rather than a somm.
{%- endcomment -%}
<div class="non-pair-hero">
  <div>
    <div class="non-mono non-eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 class="non-pair-hero__title">{{ section.settings.heading }}</h1>
  </div>
  {%- if section.settings.intro != blank -%}
    <p class="non-pair-hero__lead">{{ section.settings.intro }}</p>
  {%- endif -%}
</div>

<div class="non-section" data-non-somm-root>
  <div class="non-pair" data-non-pair>
    <div>

      {%- for block in section.blocks -%}
        <fieldset
          class="non-pair__axis"
          data-non-pair-axis="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}>
          <legend class="non-pair__q">
            <span class="non-pair__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span>{{ block.settings.question }}</span>
          </legend>

          <div class="non-pair__opts">
            {%- assign options = block.settings.options | newline_to_br | split: '<br />' -%}
            {%- for option in options -%}
              {%- assign parts = option | strip | split: '|' -%}
              {%- if parts.size >= 2 -%}
                <button
                  type="button"
                  class="non-pair__opt"
                  data-non-pair-opt
                  data-scores="{{ parts[1] | strip | escape }}"
                  data-trace="{{ parts[2] | default: '' | strip | escape }}">
                  {{ parts[0] | strip }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endfor -%}

      <div data-non-pair-result hidden style="animation:rise .4s ease both">
        <div class="non-pair__q" data-non-pair-title></div>
        <p class="non-note" data-non-pair-body style="max-width:52ch"></p>
        <button type="button" class="non-btn non-btn--ghost" data-non-pair-reset style="margin-top:18px">
          Start again
        </button>
      </div>
    </div>

    {%- comment -%}
      The verdict. The design pins a real photograph here with a live badge in
      the corner — this is the payoff for answering, and the port replaced it
      with grey placeholder text. The image is a setting so it can be swapped
      without a deploy, and it stays visible before an answer rather than
      leaving an empty column.
    {%- endcomment -%}
    <aside class="non-verdict"{% if section.settings.somm_dot_colour != blank %} style="--non-somm-dot: {{ section.settings.somm_dot_colour }}"{% endif %}>
      <div class="non-verdict__head">
        <span class="non-mono non-eyebrow">{{ section.settings.verdict_label }}</span>
        {%- if section.settings.show_live -%}
          <span class="non-verdict__live">
            <span class="non-sommbox__dot" aria-hidden="true"></span>
            {{ section.settings.live_label }}
          </span>
        {%- endif -%}
      </div>

      <div class="non-verdict__media">
        {%- if section.settings.verdict_image != blank -%}
          {{ section.settings.verdict_image | image_url: width: 1000
             | image_tag: loading: 'lazy', widths: '400,700,1000', class: 'non-verdict__img',
               alt: section.settings.verdict_label }}
        {%- elsif section.settings.verdict_image_url != blank -%}
          <img class="non-verdict__img" src="{{ section.settings.verdict_image_url }}"
               alt="{{ section.settings.verdict_label | escape }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="non-pair__trace" data-non-pair-trace>{{ section.settings.verdict_note }}</div>
      <div class="non-somm__picks" data-non-somm-picks hidden style="margin-top:18px"></div>
    </aside>
  </div>
</div>

{%- comment -%} Reasons keyed by bottle code, shown once a winner emerges. {%- endcomment -%}
<script type="application/json" data-non-pair-reasons>
  {
    {%- for block in section.blocks -%}
      {%- if block.type == 'reason' -%}
        {{ block.settings.code | upcase | json }}: {{ block.settings.reason | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  }
</script>

<script type="application/json" data-non-catalogue>
  {
    {%- for p in collections.all.products limit: 40 -%}
      {%- capture c %}{% render 'non-code', product: p %}{% endcapture -%}
      {{ c | json }}: {
        "title": {{ p.title | json }},
        "url": {{ p.url | json }},
        "image": {{ p.featured_image | image_url: width: 200 | json }},
        "price": {{ p.price | money | json }},
        "note": {{ p.metafields.custom.tastes | metafield_text | default: '' | json }},
        "variantId": {{ p.selected_or_first_available_variant.id | json }},
        "available": {{ p.available | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
</script>

<script src="{{ 'pairing.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Pairing tool",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The pairing table"
    },
    {
      "type": "header",
      "content": "The verdict"
    },
    {
      "type": "text",
      "id": "verdict_label",
      "label": "Verdict label",
      "default": "The verdict"
    },
    {
      "type": "image_picker",
      "id": "verdict_image",
      "label": "Verdict image"
    },
    {
      "type": "text",
      "id": "verdict_image_url",
      "label": "Verdict image URL",
      "info": "Used when no image is picked."
    },
    {
      "type": "textarea",
      "id": "verdict_note",
      "label": "Verdict note",
      "default": "Three answers and I will commit to a bottle, a serving temperature and a reason. No hedging."
    },
    {
      "type": "checkbox",
      "id": "show_live",
      "label": "Show the live badge",
      "default": true
    },
    {
      "type": "text",
      "id": "live_label",
      "label": "Live label",
      "default": "Somm live"
    },
    {
      "type": "color",
      "id": "somm_dot_colour",
      "label": "Live dot colour",
      "default": "#4ade80"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's on the table?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Three questions. The somm shows its working rather than just naming a bottle."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "axis",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Options",
          "info": "One per line: Label | CODE:score,CODE:score | trace line. e.g. Starters | NON1:2,NON5:1 | Light plates, needs salinity."
        }
      ]
    },
    {
      "type": "reason",
      "name": "Bottle reason",
      "settings": [
        {
          "type": "text",
          "id": "code",
          "label": "Bottle code",
          "info": "e.g. NON1"
        },
        {
          "type": "textarea",
          "id": "reason",
          "label": "Why this bottle wins"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pairing tool"
    }
  ]
}
{% endschema %}
