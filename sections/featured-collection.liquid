{% render 'section-style', section: section %}
{%- liquid
  assign coll = section.settings.collection | default: collections[settings.core_range_collection]
  assign cols = section.settings.columns | default: 4 | times: 1
  assign rows = section.settings.rows | default: 2
  # A stored 0 predates this setting being a real width — it used to mean
  # "auto". Emitting it produced max-width:0 and collapsed every card to
  # nothing. Anything below the slider's own minimum means "no cap".
  assign card_max = section.settings.card_max | default: 0
  if card_max < 120
    assign card_max = 0
  endif

  comment
    Two layouts.

    Grid  — columns x rows, the count follows the shape.
    Row   — one line holding the WHOLE collection, scrolling sideways with
            arrows when it overruns. This exists because "show me all six"
            and "fit them on screen" are not the same request: a grid has to
            wrap, a row does not.
  endcomment
  assign layout = section.settings.layout | default: 'grid'
  if layout == 'row'
    assign limit = 50
  else
    assign limit = cols | times: rows
  endif
-%}

<div class="non-section">
  <div class="non-section__head">
    <h2 class="non-section__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a class="non-section__more" href="{{ section.settings.link_url | default: coll.url }}">
        {{ section.settings.link_label }} &rarr;
      </a>
    {%- endif -%}
  </div>

  {%- if coll.products.size > 0 -%}
    {%- if layout == 'row' -%}
      <div class="non-row-wrap" data-non-row-wrap>
        <button type="button" class="non-row-arrow non-row-arrow--prev" data-non-row-prev aria-label="Previous">&#8592;</button>
        <div
          class="non-row non-grid--ratio-{{ section.settings.image_ratio | default: 'portrait' }}"
          data-non-row
         {% if card_max > 0 %} style="--non-card-max: {{ card_max }}px"{% endif %}>
          {%- for product in coll.products limit: limit -%}
            {% render 'product-card', product: product, show_add: section.settings.show_add %}
          {%- endfor -%}
        </div>
        <button type="button" class="non-row-arrow non-row-arrow--next" data-non-row-next aria-label="Next">&#8594;</button>
      </div>
      <script src="{{ 'row-scroller.js' | asset_url }}" defer></script>
    {%- else -%}
      <div
        class="non-grid non-grid--{{ section.settings.columns }} non-grid--ratio-{{ section.settings.image_ratio | default: 'portrait' }}"
       {% if card_max > 0 %} style="--non-card-max: {{ card_max }}px"{% endif %}>
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, show_add: section.settings.show_add %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <p class="non-note" style="margin-top:24px">
      Pick a collection for this section in the theme editor.
    </p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Core range"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid (columns x rows)"
        },
        {
          "value": "row",
          "label": "One row, scrolls sideways"
        }
      ],
      "default": "grid",
      "info": "A row shows the whole collection on one line, with arrows when it runs off screen."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Rows",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2,
      "info": "Products shown = columns x rows."
    },
    {
      "type": "range",
      "id": "card_max",
      "label": "Card width",
      "min": 120,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 640,
      "info": "How wide a card may get. Drag left for smaller pictures."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "info": "Exact number of products per row on desktop.",
      "default": "4"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "tall",
          "label": "Tall (4:5)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_add",
      "label": "Show add to cart on cards",
      "default": false
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All bottles"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}
