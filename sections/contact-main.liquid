{% render 'section-style', section: section %}
{%- comment -%}
  Contact.

  The page body is empty on the live store — the old theme carried the form in
  its own section, so a template that only prints page.content renders nothing.
  This supplies the form.

  Posts through Shopify's native contact form, which emails the store contact
  address (hello@non.world) with the customer's address as reply-to. No app, no
  endpoint, nothing to keep alive.
{%- endcomment -%}

{%- comment -%}
  The dash field is the section's background, not a panel inside it. It was a
  bordered box in the aside column, which read as a widget sitting on the page
  rather than as the page. Absolutely positioned behind everything, no border,
  no background of its own — the section's own colour shows through and the
  field is drawn over it.

  The envelope is offset rather than centred: at 50% it sat under the form
  column. envelope_x moves it into the empty right-hand half where there is
  nothing to compete with.

  aria-hidden and pointer-events: none — it is decoration, it must not
  intercept a click meant for the form or announce itself to a screen reader.
{%- endcomment -%}
<div class="non-section non-contact-section">
  {%- if section.settings.show_field -%}
    <div
      class="non-contact-field"
      data-non-contact-field
      data-density="{{ section.settings.field_density }}"
      data-ink="{{ section.settings.field_ink | default: '242,240,234' }}"
      data-envelope-x="{{ section.settings.field_envelope_x | divided_by: 100.0 }}"
      data-envelope-scale="{{ section.settings.field_envelope_scale | divided_by: 100.0 }}"
      aria-hidden="true">
      <canvas></canvas>
    </div>
    <script src="{{ 'contact-field.js' | asset_url }}" defer></script>
  {%- endif -%}

  {%- comment -%}
    The same page header every other page has: mono eyebrow, display heading,
    supporting line to the right. Contact was the odd one out — it opened with
    an 11px uppercase .non-section__title, which is the label used INSIDE a
    section, so the page had no header at all by the standard the rest of the
    site sets. Reuses the Stockists/Pairing hero rules rather than a third copy.
  {%- endcomment -%}
  <div class="non-contact-hero">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <div class="non-mono non-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h1 class="non-contact-hero__title">{{ page.title | default: section.settings.heading }}</h1>
    </div>
    {%- if section.settings.lead != blank or settings.contact_email != blank -%}
      <p class="non-contact-hero__lead">
        {{ section.settings.lead }}
        {%- if settings.contact_email != blank -%}
          {% if section.settings.lead != blank %} {% endif %}<a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>

  {%- if page.content != blank -%}
    <div class="non-rte" style="margin-top:26px">{{ page.content }}</div>
  {%- elsif section.settings.intro != blank -%}
    <p class="non-hero__blurb" style="margin-top:22px">{{ section.settings.intro }}</p>
  {%- endif -%}

  <div class="non-stockists" style="margin-top:34px">
    <div>
      {%- form 'contact' -%}
        {%- if form.posted_successfully? -%}
          <p class="non-note">{{ section.settings.success_message }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="non-error">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <div style="display:grid;grid-template-columns:1fr;gap:18px;max-width:560px">
            <div>
              <label class="non-label" for="c-name">Name</label>
              <input class="non-field" type="text" id="c-name" name="contact[name]" required>
            </div>

            <div>
              <label class="non-label" for="c-email">Email</label>
              <input class="non-field" type="email" id="c-email" name="contact[email]" required>
            </div>

            <div>
              <label class="non-label" for="c-topic">What's it about</label>
              <select class="non-field" id="c-topic" name="contact[topic]">
                {%- for block in section.blocks -%}
                  <option value="{{ block.settings.label | escape }}">{{ block.settings.label }}</option>
                {%- endfor -%}
              </select>
            </div>

            <div>
              <label class="non-label" for="c-body">Message</label>
              <textarea class="non-field" id="c-body" name="contact[body]" rows="6" required></textarea>
            </div>
          </div>

          <button type="submit" class="non-btn" style="margin-top:22px">
            {{ section.settings.submit_label }}
          </button>

          <p class="non-mono non-eyebrow" style="margin-top:14px;letter-spacing:.12em">
            Goes to {{ settings.contact_email | default: 'hello@non.world' }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>

    <aside>
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 900, format: 'webp'
          | image_tag: loading: 'lazy', widths: '420,640,900', alt: page.title | default: 'NON'
        }}
      {%- endif -%}

      {%- if section.settings.aside_heading != blank -%}
        <div class="non-mono non-eyebrow" style="margin-top:22px">{{ section.settings.aside_heading }}</div>
        <div class="non-rte" style="margin-top:12px;font-size:var(--t-copy)">
          {{ section.settings.aside_text }}
        </div>
      {%- endif -%}
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "info": "Shown only when the page body is empty.",
      "default": "Trade enquiries, press, stockist requests or something that has gone wrong. We answer everything."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Send"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Got it. We'll come back to you, usually the same day."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "aside_heading",
      "label": "Aside heading"
    },
    {
      "type": "richtext",
      "id": "aside_text",
      "label": "Aside text"
    },
    {
      "type": "checkbox",
      "id": "show_field",
      "label": "Show the dash field",
      "default": true
    },
    {
      "type": "range",
      "id": "field_density",
      "label": "Dash spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px",
      "info": "Lower is denser and costs more to draw. 20 matches the supplied design."
    },
    {
      "type": "range",
      "id": "field_envelope_x",
      "label": "Envelope position",
      "min": 30,
      "max": 85,
      "step": 5,
      "default": 70,
      "unit": "%",
      "info": "Across the section. 50 centres it, which puts it under the form."
    },
    {
      "type": "range",
      "id": "field_envelope_scale",
      "label": "Envelope size",
      "min": 60,
      "max": 220,
      "step": 10,
      "default": 140,
      "unit": "%",
      "info": "Relative to the supplied design."
    },
    {
      "type": "text",
      "id": "field_ink",
      "label": "Ink (R,G,B)",
      "default": "242,240,234",
      "info": "Comma-separated RGB, no rgb() wrapper. Defaults to the theme's ink."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Trade enquiries, press, stockists or a question about a bottle — this reaches a person."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
