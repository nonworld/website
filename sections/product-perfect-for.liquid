{%- comment -%}
  "Made for" — the food photography attached to every bottle.

  Two ways to fill this, in priority order:

  1. Blocks. Add a "Tile" in the theme editor, pick an image, write a caption.
     This is the editable path and it wins whenever any block exists.

  2. The product metafields, used when no blocks are added:
       custom.perfect_for_images   list.file_reference
       custom.perfect_for_captions list.single_line_text
     They are positional — image[i] belongs to caption[i] — and nothing links
     them beyond order, so a mismatched count silently pairs the wrong caption
     to the wrong plate. The head still reports a mismatch rather than hiding
     it.

  The fallback exists so that populating the metafields keeps working for the
  whole catalogue without anyone opening the editor for 27 products, while any
  single product can be overridden by hand.
{%- endcomment -%}

{%- liquid
  assign images = product.metafields.custom.perfect_for_images.value
  assign captions = product.metafields.custom.perfect_for_captions.value

  assign use_blocks = false
  if section.blocks.size > 0
    assign use_blocks = true
  endif

  assign has_meta = false
  if images.size > 0
    assign has_meta = true
  endif

  assign ratio = section.settings.image_ratio | default: 'tall'
-%}

{%- if use_blocks or has_meta -%}
  <div class="non-section">
    <div class="non-section__head">
      <h2 class="non-section__title">{{ section.settings.heading }}</h2>
      {%- unless use_blocks -%}
        {%- if images.size != captions.size -%}
          <span class="non-section__more">{{ images.size }} images, {{ captions.size }} captions</span>
        {%- endif -%}
      {%- endunless -%}
    </div>
  </div>

  <div class="non-trip non-trip--ratio-{{ ratio }}">
    {%- if use_blocks -%}
      {%- for block in section.blocks -%}
        <div class="non-trip__cell" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- comment -%}
              The class goes on the img itself. image_tag emits its own width
              and height attributes, and without a class carrying the ratio the
              intrinsic size of each photo wins — which is what left two of the
              three tiles short and the caption stranded over black.
            {%- endcomment -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400,600,900,1200',
                class: 'non-trip__img',
                alt: block.settings.caption | default: product.title
            }}
          {%- else -%}
            <div class="non-trip__img non-trip__img--empty"></div>
          {%- endif -%}

          {%- if block.settings.caption != blank -%}
            <div class="non-trip__cap">
              <div class="non-trip__title">{{ block.settings.caption }}</div>
              {%- if block.settings.subcaption != blank -%}
                <div class="non-trip__sub">{{ block.settings.subcaption }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for image in images -%}
        <div class="non-trip__cell">
          {{
            image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400,600,900,1200',
              class: 'non-trip__img',
              alt: captions[forloop.index0] | default: product.title
          }}
          {%- assign caption = captions[forloop.index0] -%}
          {%- if caption != blank -%}
            <div class="non-trip__cap">
              <div class="non-trip__title">{{ caption }}</div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Made for",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "tall", "label": "Tall (4:5)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (3:2)" }
      ],
      "default": "tall",
      "info": "Applies to every tile, so the row stays even."
    },
    {
      "type": "paragraph",
      "content": "Add a Tile to choose your own images. With no tiles, this falls back to the product's Made-for metafields."
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Made for" },
        { "type": "text", "id": "subcaption", "label": "Sub-caption" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Made for" }]
}
{% endschema %}
