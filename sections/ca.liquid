<div>ca</div>
{% schema %}
{
  "name": "CA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "info": "Shown only when the page body is empty.",
      "default": "Trade enquiries, press, stockist requests or something that has gone wrong. We answer everything."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Send"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Got it. We'll come back to you, usually the same day."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "aside_heading",
      "label": "Aside heading"
    },
    {
      "type": "richtext",
      "id": "aside_text",
      "label": "Aside text"
    },
    {
      "type": "checkbox",
      "id": "show_field",
      "label": "Show the dash field",
      "default": true
    },
    {
      "type": "range",
      "id": "field_density",
      "label": "Dash spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px",
      "info": "Lower is denser and costs more to draw. 20 matches the supplied design."
    },
    {
      "type": "range",
      "id": "field_envelope_x",
      "label": "Envelope position",
      "min": 30,
      "max": 85,
      "step": 5,
      "default": 70,
      "unit": "%",
      "info": "Across the section. 50 centres it, which puts it under the form."
    },
    {
      "type": "range",
      "id": "field_envelope_scale",
      "label": "Envelope size",
      "min": 60,
      "max": 220,
      "step": 10,
      "default": 140,
      "unit": "%",
      "info": "Relative to the supplied design."
    },
    {
      "type": "text",
      "id": "field_ink",
      "label": "Ink (R,G,B)",
      "default": "242,240,234",
      "info": "Comma-separated RGB, no rgb() wrapper. Defaults to the theme's ink."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Trade enquiries, press, stockists or a question about a bottle — this reaches a person."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CA"
    }
  ]
}
{% endschema %}
