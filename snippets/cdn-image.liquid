{%- comment -%}
  A responsive <img> for images referenced by URL rather than by Shopify image
  object.

  Sections that store a CDN URL in a text setting — the hero slides, the
  triptych, the split panels, the NONHQ rooms — were emitting a bare
  <img src>. One file, one size, to every device. On a 375px phone the hero
  shipped 1080x1350 into a 375px slot, and it is the LCP element, so it hit the
  metric that matters most on mobile hardest.

  Shopify's CDN resizes from a query parameter, so a srcset can be built from
  any /cdn/shop/ URL without re-uploading anything. The width param is
  normalised first: the stored URLs already carry ?width=1200 and appending a
  second one wins silently in some CDNs and loses in others.

  format=webp is belt-and-braces, NOT the lever. Measured on the live CDN with
  real <img> requests: NON3-5.jpg at width=900 returns 73,290 bytes with the
  parameter and 73,290 without it. The same URL fetched with Accept: */*
  returns 126,095 bytes of jpeg. The CDN is already negotiating format from the
  Accept header and has been all along — the parameter only matters for a
  client that fails to advertise webp support.

  Falls back to a plain img for anything not on the Shopify CDN, because the
  width parameter would do nothing there and a srcset of identical files is
  worse than none.

  Usage:
    {% render 'cdn-image',
       url: block.settings.image_url,
       alt: block.settings.title,
       sizes: '(min-width: 860px) 40vw, 100vw',
       class: 'non-trip__img',
       eager: true %}
{%- endcomment -%}

{%- liquid
  assign src = url | split: '?' | first
  assign is_shopify_cdn = false
  if src contains '/cdn/shop/' or src contains 'cdn.shopify.com'
    assign is_shopify_cdn = true
  endif

  assign v = ''
  if url contains 'v='
    assign v = url | split: 'v=' | last | split: '&' | first
  endif

  assign widths = widths | default: '400,600,900,1200,1600'
  assign sizes = sizes | default: '100vw'
  assign loading = 'lazy'
  assign priority = ''
  if eager
    assign loading = 'eager'
    assign priority = 'high'
  endif
-%}

{%- if is_shopify_cdn -%}
  {%- capture srcset -%}
    {%- assign list = widths | split: ',' -%}
    {%- for w in list -%}
      {%- assign ww = w | strip -%}
      {{ src }}?{% if v != blank %}v={{ v }}&{% endif %}width={{ ww }}&format=webp {{ ww }}w
      {%- unless forloop.last -%}, {% endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if defer -%}
    {%- comment -%}
      Deferred, because loading="lazy" cannot help here.

      The hero carousel stacks all five slides on top of each other, so every
      one of them is inside the viewport from the first paint and the browser
      fetches the lot. Measured on the homepage at 375px: 481KB of hero for a
      component that shows one image at a time, 74% of every image byte on the
      page.

      So the non-first slides ship no src at all. carousel.js promotes
      data-src to src once the page is idle or the carousel first advances,
      whichever comes first. The <noscript> copy keeps them working with
      JavaScript off, where there is no rotation and the markup is all there is.
    {%- endcomment -%}
    <img
      data-src="{{ src }}?{% if v != blank %}v={{ v }}&{% endif %}width=1200&format=webp"
      data-srcset="{{ srcset | strip }}"
      sizes="{{ sizes }}"
      alt="{{ alt | default: shop.name | escape }}"
      {% if class != blank %}class="{{ class }}"{% endif %}
      loading="lazy"
      decoding="async">
    <noscript>
      <img
        src="{{ src }}?{% if v != blank %}v={{ v }}&{% endif %}width=1200&format=webp"
        srcset="{{ srcset | strip }}"
        sizes="{{ sizes }}"
        alt="{{ alt | default: shop.name | escape }}"
        {% if class != blank %}class="{{ class }}"{% endif %}
        loading="lazy"
        decoding="async">
    </noscript>
  {%- else -%}
    <img
      src="{{ src }}?{% if v != blank %}v={{ v }}&{% endif %}width=1200&format=webp"
      srcset="{{ srcset | strip }}"
      sizes="{{ sizes }}"
      alt="{{ alt | default: shop.name | escape }}"
      {% if class != blank %}class="{{ class }}"{% endif %}
      loading="{{ loading }}"
      {% if priority != blank %}fetchpriority="{{ priority }}"{% endif %}
      decoding="async">
  {%- endif -%}
{%- else -%}
  <img
    src="{{ url }}"
    alt="{{ alt | default: shop.name | escape }}"
    {% if class != blank %}class="{{ class }}"{% endif %}
    loading="{{ loading }}"
    {% if priority != blank %}fetchpriority="{{ priority }}"{% endif %}
    decoding="async">
{%- endif -%}
