{%- comment -%}
  Language picker, on Shopify's own localization form.

  Params:
    id       (required) — unique suffix, since this renders twice (bar + drawer)
    compact  optional   — the header bar version; the drawer version is stacked

  LANGUAGE ONLY. There was a country/region select here too, and Aaron removed
  it: pricing and catalogue are native to the market, resolved by geo, so a
  country control read as a currency converter and invited people to change
  something that should just be correct.

  Native form post to /localization — no app, no client-side URL rewriting, and
  it keeps the visitor on the page they were reading. The list comes from
  localization.available_languages, so publishing or unpublishing a language in
  admin changes this with no theme edit.

  Renders nothing at all when only one language is published. A selector that
  cannot select is worse than none.

  noscript-safe: a real form with a real submit button, so it works with
  JavaScript off. localization.js only hides the button and auto-submits.
{%- endcomment -%}

{%- assign has_languages = false -%}
{%- if localization.available_languages.size > 1 -%}{%- assign has_languages = true -%}{%- endif -%}

{%- if has_languages -%}
  <form
    method="post"
    action="{{ routes.root_url }}localization"
    id="localization-{{ id }}"
    class="non-loc{% if compact %} non-loc--compact{% endif %}"
    accept-charset="UTF-8"
    enctype="multipart/form-data"
    data-non-loc>
    <input type="hidden" name="form_type" value="localization">
    <input type="hidden" name="utf8" value="✓">
    <input type="hidden" name="_method" value="put">
    <input type="hidden" name="return_to" value="{{ request.path | escape }}">

    <label class="visually-hidden" for="loc-language-{{ id }}">
        {{ 'localization.language_label' | t }}
      </label>
    <select
    id="loc-language-{{ id }}"
    class="non-loc__select"
    name="locale_code"
    data-non-loc-select>
        {%- for language in localization.available_languages -%}
          <option
            value="{{ language.iso_code }}"
            lang="{{ language.iso_code }}"
            {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
            {{ language.endonym_name | capitalize }}
          </option>
        {%- endfor -%}
    </select>

    <button type="submit" class="non-loc__go" data-non-loc-go>
      {{ 'localization.update' | t }}
    </button>
  </form>
{%- endif -%}
