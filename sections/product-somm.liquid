{% render 'section-style', section: section %}
{%- comment -%}
  "STILL DECIDING?" — the Somm, in its own place on the page.

  It used to sit inside the buy column, directly under the shipping line. That
  was the right instinct and the wrong position: a customer reading the buy
  block is deciding whether to buy, and the questions the Somm answers — what
  does it taste like, what does it go with — are answered by the two bands
  above this one. Offering it here means offering it to the people who read
  those bands and still are not sure.

  It is a SECTION rather than part of the product template's main block for one
  reason: DOM order. The brief's sequence puts it after the food pairings, and
  the pairings are their own section, so pulling it up or down with CSS would
  put the keyboard through the page in a different order to the eye. Moving it
  in the markup costs nothing and cannot drift.

  Every control here opens the shared sheet with this bottle's context already
  attached. There is no second field and no second transcript.
{%- endcomment -%}

{%- capture code %}{% render 'non-code', product: product %}{% endcapture -%}
{%- assign code = code | strip -%}
{%- capture product_orb_caption -%}{{ 'sections.somm.orb_ask_about' | t: code: code }}{%- endcapture -%}
{%- assign product_orb_caption = product_orb_caption | strip -%}
{%- liquid
  assign m = product.metafields.custom
  assign not_drink = m.not_a_drink | metafield_text
  # Same test the rest of the page uses: does this product carry ONE bottle's
  # spec sheet? A set has none, and the Somm has nothing to be contextual about.
  assign has_spec = false
  if m.profile != blank or m.tastes != blank or m.sits != blank or m.ingredients != blank
    assign has_spec = true
  endif
-%}

{%- if section.settings.show_somm and not_drink == blank and has_spec -%}
  {%- assign pdp_variant = product.selected_or_first_available_variant -%}
  <div class="non-somm-entry non-somm-entry--pdp" data-non-somm-entry>
  {%- comment -%}
    The same orb, the same size, carrying this bottle. It makes the band read
    as the Somm's part of the product page rather than as another CTA.
  {%- endcomment -%}
  {% render 'somm-orb',
     orb_variant: 'integrated',
     orb_surface: 'product_page',
     orb_context: 'product',
     orb_code: code,
     orb_caption: product_orb_caption,
     product: product %}

    {%- if section.settings.somm_pdp_label != blank -%}
      <div class="non-mono non-eyebrow non-somm-entry__label">
        {{ section.settings.label }} {{ code }}?
      </div>
    {%- endif -%}

    <button
      type="button"
      class="non-somm-entry__field"
      data-non-somm-open
      data-non-somm-pdp
      data-somm-surface="product_page"
      data-somm-context="product"
      data-somm-code="{{ code }}"
      data-somm-product="{{ product.id }}"
      data-somm-variant="{{ pdp_variant.id }}"
      data-somm-product-title="{{ product.title | escape }}"
      data-somm-product-price="{{ pdp_variant.price | money }}"
      data-somm-product-available="{{ pdp_variant.available }}">
      <span class="non-somm-entry__ph">{{ section.settings.placeholder }}</span>
      <span class="non-somm-entry__go" aria-hidden="true">&rarr;</span>
    </button>

    {%- comment -%}
      Three, one line, scrolling. The same ceiling as the homepage and for
      the same reason — a fourth chip is the one that makes the row wrap
      and turns a hint into a form.
    {%- endcomment -%}
    {%- assign pdp_seeds = section.blocks | where: 'type', 'seed' -%}
    {%- if pdp_seeds.size > 0 -%}
      <div class="non-somm-entry__chips">
        {%- for block in pdp_seeds limit: 3 -%}
          <button
            type="button"
            class="non-somm__seed non-somm-entry__chip"
            data-non-somm-open
            data-non-somm-pdp
            data-somm-surface="product_page"
            data-somm-context="product"
            data-somm-code="{{ code }}"
            data-somm-product="{{ product.id }}"
            data-somm-variant="{{ pdp_variant.id }}"
            data-somm-product-title="{{ product.title | escape }}"
            data-somm-product-price="{{ pdp_variant.price | money }}"
            data-somm-product-available="{{ pdp_variant.available }}"
            data-somm-prompt="{{ block.settings.label | escape }}"
            {{ block.shopify_attributes }}>
            {{ block.settings.short_label | default: block.settings.label }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}



{% schema %}
{
  "name": "Product Somm",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_somm",
      "label": "Show the NON Somm entry",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow",
      "default": "Still deciding?",
      "info": "The product code is appended, so \"Still deciding?\" reads \"Still deciding? NON1\"."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Prompt",
      "default": "Ask about taste, food or fit"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    { "type": "color", "id": "bg_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text colour" },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        { "value": "", "label": "Theme default" },
        { "value": "sans", "label": "Helvetica (all text)" },
        { "value": "mono", "label": "JetBrains Mono (all text)" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "seed",
      "name": "Suggested question",
      "settings": [
        { "type": "text", "id": "label", "label": "Question" },
        {
          "type": "text",
          "id": "short_label",
          "label": "Short label",
          "info": "A few words for the chip. It must SHORTEN the question above, not replace it — the chip is what the customer reads and the full question is what gets asked."
        }
      ]
    }
  ],
  "presets": [ { "name": "Product Somm" } ]
}
{% endschema %}
