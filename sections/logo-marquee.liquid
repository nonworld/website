{% render 'section-style', section: section %}
{%- if section.blocks.size > 0 -%}
  <div class="non-poured">
    <div class="non-poured__label">{{ section.settings.heading }}</div>
    <div class="non-poured__track" aria-hidden="true">
      {%- for i in (1..4) -%}
        <div class="non-poured__set">
          {%- for block in section.blocks -%}
            {%- comment -%}
              Captured, not inlined. This was written as a filter argument
              holding its own output tag — a nested set of braces inside an
              output tag, which is a hard Liquid syntax error, and Shopify
              rejected the whole file while git happily reported success.
            {%- endcomment -%}
            {%- capture logo_style -%}
              --logo-scale:{{ block.settings.scale | default: 100 | divided_by: 100.0 }}
            {%- endcapture -%}
            {%- assign logo_style = logo_style | strip -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 300, format: 'webp'
                | image_tag:
                  loading: 'lazy',
                  alt: block.settings.name,
                  style: logo_style
              }}
            {%- elsif block.settings.image_url != blank -%}
              {%- comment -%}
                A custom property, not a max-height. The old inline
                max-height BEAT every stylesheet rule, which is why the row
                stayed uneven whatever the CSS said. This one feeds the rule
                in theme.css instead of overriding it.
              {%- endcomment -%}
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.name | escape }}"
                loading="lazy"
                style="{{ logo_style }}">
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    <ul class="visually-hidden">
      {%- for block in section.blocks -%}
        <li>{{ block.settings.name }}</li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Poured at",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Poured at"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    },
    {
      "type": "range",
      "id": "mobile_order",
      "label": "Position on mobile",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Where this section sits on a phone, low to high. Desktop keeps the order in the template regardless. 0 leaves it where it is."
    }
  ],
  "blocks": [
    {
      "type": "venue",
      "name": "Venue",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Logo URL",
          "info": "Used only when no image is uploaded."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Venue name"
        },
        {
          "type": "range",
          "id": "scale",
          "label": "Size",
          "min": 60,
          "max": 180,
          "step": 5,
          "unit": "%",
          "default": 100,
          "info": "Relative to the other logos. Wordmarks and round marks never balance at one size — trim each one here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Poured at"
    }
  ],
  "max_blocks": 30
}
{% endschema %}
