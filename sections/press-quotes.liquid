<div class="non-press">
  <div class="non-mono non-eyebrow">{{ section.settings.heading }}</div>

  <div class="non-press__list">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <blockquote class="non-press__quote" style="margin:0">
          &ldquo;{{ block.settings.quote }}&rdquo;
        </blockquote>
        <div class="non-press__cite">{{ block.settings.source }}</div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Press",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Press" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "source", "label": "Publication" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "quote",
        "settings": {
          "quote": "NON isn't trying to be an imitation of wine, but rather its own, distinct flavor.",
          "source": "Rolling Stone"
        }
      },
      {
        "type": "quote",
        "settings": { "quote": "NON isn't just a drink; it's an experience.", "source": "Forbes" }
      }
    ]
  },
  "presets": [{ "name": "Press" }]
}
{% endschema %}
