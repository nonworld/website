{% render 'section-style', section: section %}
<div class="non-section">
  <div class="non-section__head">
    <h1 class="non-section__title">{{ 'general.search.heading' | t }}</h1>
    {%- if search.performed -%}
      <span class="non-section__more">
        {{ 'general.search.results_with_count' | t: count: search.results_count }}
      </span>
    {%- endif -%}
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top:24px;display:flex;gap:8px;max-width:520px">
    <label class="visually-hidden" for="q">{{ 'general.search.placeholder' | t }}</label>
    <input class="non-field" type="search" id="q" name="q" value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}">
    <button type="submit" class="non-btn">{{ 'general.search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <div class="non-grid non-grid--3" style="margin-top:30px">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <div>
              <a href="{{ item.url }}" class="non-card__name">{{ item.title }}</a>
              <p class="non-card__note">{{ item.content | strip_html | truncatewords: 24 }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="non-note" style="margin-top:26px">
        {{ 'general.search.no_results' | t: terms: search.terms }}
      </p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ]
}
{% endschema %}
