{% render 'section-style', section: section %}
{%- comment -%}
  About.

  The About Us page body is empty on the live store — the old theme carried the
  copy in its own sections — so a template that only prints page.content shows
  nothing. This section carries the structure from the design (about.html):
  lead, origin, founder quote, the four things every glass is built from, and
  the two "what we're not" statements.

  Everything is editable. The defaults are the design's copy verbatim.
{%- endcomment -%}

{%- comment -%}
  The page title was the <h1>, rendered through .non-section__title at 11px,
  while the actual statement sat in an <h2> capped at 58px. The design puts the
  statement at 88px and treats it as the page's one heading — so the eyebrow is
  an eyebrow now and the statement is the h1.
{%- endcomment -%}
<div class="non-about-hero">
  <div>
    <div class="non-mono non-eyebrow">
      {{ section.settings.eyebrow | default: page.title }}
    </div>
    <h1 class="non-about-hero__title">{{ section.settings.heading }}</h1>
  </div>

  {%- if section.settings.lead != blank -%}
    <p class="non-about-hero__lead">{{ section.settings.lead }}</p>
  {%- endif -%}
</div>

{%- assign creds = section.blocks | where: 'type', 'credential' -%}
{%- if creds.size > 0 -%}
  {%- comment -%}
    The design's credentials strip. Static rather than scrolling: four short
    facts fit on one line, and animating something nobody needs to read twice
    is motion for its own sake.
  {%- endcomment -%}
  <div class="non-creds">
    {%- for b in creds -%}
      <span class="non-creds__item" {{ b.shopify_attributes }}>{{ b.settings.text }}</span>
    {%- endfor -%}
  </div>
{%- endif -%}

<div class="non-section">

  {%- if page.content != blank -%}
    <div class="non-rte" style="margin-top:26px">{{ page.content }}</div>
  {%- endif -%}
</div>

{%- comment -%}
  The design's About page carried no photography at all — it was type only. So
  these slots are an addition rather than a restoration, and each falls back to
  an image already on NON's CDN.
{%- endcomment -%}
{%- if section.settings.lead_image != blank or section.settings.lead_image_url != blank -%}
  <div class="non-split__cell" style="min-height:0">
    {%- if section.settings.lead_image != blank -%}
      {{ section.settings.lead_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '800,1200,1800', class: 'non-about__band', alt: section.settings.heading }}
    {%- else -%}
      <img class="non-about__band" src="{{ section.settings.lead_image_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {%- endif -%}
  </div>
{%- endif -%}

{%- comment -%} ── origin ────────────────────────────────────────────────── {%- endcomment -%}
{%- if section.settings.origin_body != blank -%}
  <div class="non-section" style="border-top:1px solid var(--non-line)">
    <div class="non-press">
      <div class="non-mono non-eyebrow">{{ section.settings.origin_label }}</div>
      <div>
        <div class="non-step__t" style="font-size:clamp(20px,1.9vw,30px);max-width:34ch">
          {{ section.settings.origin_heading }}
        </div>
        <div class="non-rte" style="margin-top:18px">{{ section.settings.origin_body }}</div>

        {%- if section.settings.origin_image != blank or section.settings.origin_image_url != blank -%}
          <div style="margin-top:26px">
            {%- if section.settings.origin_image != blank -%}
              {{ section.settings.origin_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', alt: section.settings.origin_heading }}
            {%- else -%}
              <img src="{{ section.settings.origin_image_url }}" alt="{{ section.settings.origin_heading | escape }}" loading="lazy">
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <blockquote class="non-press__quote" style="margin:34px 0 0">
            &ldquo;{{ section.settings.quote }}&rdquo;
          </blockquote>
          <div class="non-press__cite">{{ section.settings.quote_cite }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} ── the four pillars ──────────────────────────────────────── {%- endcomment -%}
{%- assign pillars = section.blocks | where: 'type', 'pillar' -%}
{%- if pillars.size > 0 -%}
  <div class="non-section" style="border-top:1px solid var(--non-line)">
    <div class="non-section__head">
      <h2 class="non-section__title">{{ section.settings.pillars_label }}</h2>
      <span class="non-section__more">{{ section.settings.pillars_heading }}</span>
    </div>

    <div class="non-grid non-grid--4" style="margin-top:30px">
      {%- for block in pillars -%}
        <div {{ block.shopify_attributes }}>
          <div class="non-step__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <div class="non-step__t">{{ block.settings.title }}</div>
          <p class="non-step__b">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- comment -%} ── what we're not ────────────────────────────────────────── {%- endcomment -%}
{%- if section.settings.hard_heading != blank -%}
  <div class="non-section non-hard">
    <div>
      <div class="non-mono non-eyebrow">{{ section.settings.hard_label }}</div>
      <h2 class="non-hard__title">{{ section.settings.hard_heading }}</h2>
    </div>
    <div>
      <p class="non-hard__body">{{ section.settings.hard_body }}</p>

      {%- if section.settings.who_body != blank or section.settings.where_body != blank -%}
        <dl class="non-hard__facts">
          {%- if section.settings.who_body != blank -%}
            <dt class="non-mono non-eyebrow">{{ section.settings.who_label }}</dt>
            <dd>{{ section.settings.who_body }}</dd>
          {%- endif -%}
          {%- if section.settings.where_body != blank -%}
            <dt class="non-mono non-eyebrow">{{ section.settings.where_label }}</dt>
            <dd>{{ section.settings.where_body }}</dd>
          {%- endif -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- assign nots = section.blocks | where: 'type', 'not' -%}
{%- if nots.size > 0 -%}
  <div class="non-section" style="border-top:1px solid var(--non-line)">
    <div class="non-section__head">
      <h2 class="non-section__title">{{ section.settings.nots_label }}</h2>
    </div>

    <div class="non-grid" style="margin-top:26px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
      {%- for block in nots -%}
        <div {{ block.shopify_attributes }}>
          <div class="non-step__t">{{ block.settings.title }}</div>
          <p class="non-step__b">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- assign stats = section.blocks | where: 'type', 'stat' -%}
{%- if stats.size > 0 -%}
  <div class="non-section">
    <div class="non-section__head">
      <h2 class="non-section__title">{{ section.settings.stats_label }}</h2>
      <span class="non-section__more">{{ section.settings.stats_note }}</span>
    </div>
    <div class="non-stats">
      {%- for b in stats -%}
        <div class="non-stat" {{ b.shopify_attributes }}>
          <div class="non-stat__v">{{ b.settings.value }}</div>
          <p class="non-stat__b">{{ b.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- assign ctas = section.blocks | where: 'type', 'cta' -%}
{%- if ctas.size > 0 -%}
  <div class="non-about-ctas">
    {%- for b in ctas -%}
      <div class="non-about-cta{% if forloop.first %} non-about-cta--solid{% endif %}" {{ b.shopify_attributes }}>
        <div class="non-about-cta__title">{{ b.settings.title }}</div>
        <p class="non-about-cta__body">{{ b.settings.body }}</p>
        {%- if b.settings.label != blank -%}
          <a class="non-about-cta__link" href="{{ b.settings.url | default: '/' }}">{{ b.settings.label }}</a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "About",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We don't mimic wine. We make something else."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "A chef-led drinks company in Melbourne, building wine alternatives out of real produce — fruit, tannin, salinity, acidity — and nothing that has ever been fermented."
    },
    {
      "type": "image_picker",
      "id": "lead_image",
      "label": "Lead image"
    },
    {
      "type": "text",
      "id": "lead_image_url",
      "label": "Lead image URL",
      "info": "Used only when no image is uploaded.",
