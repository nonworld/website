            "label": "Fruit",
            "title": "Cooked, not fermented",
            "body": "Whole fruit is steeped, roasted or dehydrated until the flavour concentrates. Nothing ferments and nothing is stripped out later."
          }
        },
        "p_s2": {
          "type": "procstep",
          "settings": {
            "image_alt": "",
            "scene": "tannin",
            "label": "Tannin",
            "title": "Grip, from leaves and skins",
            "body": "Tea, chamomile, hops or skins go in for tannin — the drying grip that makes a drink feel like wine rather than juice."
          }
        },
        "p_s3": {
          "type": "procstep",
          "settings": {
            "image_alt": "",
            "scene": "salinity",
            "label": "Salinity",
            "title": "A pinch of salt",
            "body": "Salt for salinity: the thing that makes a sip ask for the next one, and the reason these sit beside food."
          }
        },
        "p_s4": {
          "type": "procstep",
          "settings": {
            "image_alt": "",
            "scene": "acidity",
            "label": "Acidity",
            "title": "Verjus, not vinegar",
            "body": "Unripe Semillon grapes from the Barossa, pressed into verjus. Acidity with none of the sharpness vinegar would bring."
          }
        },
        "p_s5": {
          "type": "procstep",
          "settings": {
            "image_alt": "",
            "scene": "balance",
            "label": "Balance",
            "title": "Tasted to level",
            "body": "Sugar goes in last and only as far as the fruit needs. Balance is judged in the kitchen, by tasting."
          }
        },
        "p_b1": {
          "type": "procbottle",
          "settings": {
            "code": "NON1",
            "accent": "#d9576e",
            "fruit": "berry",
            "bot": "flower",
            "titles": "Cold steep\nChamomile in\nA pinch of salt\nVerjus pressed\nTasted to level",
            "bodies": "48 hours of freeze-dried Tasmanian raspberries steeping cold. Freeze drying pulls 85% of the water out and leaves the flavour behind.\nChamomile carries the tannin and the creamy, floral finish. Raspberry skins add a little grip of their own.\nMurray River salt for salinity — the thing that makes a sip ask for the next one.\nUnripe Semillon grapes from the Barossa Valley, pressed into verjus. Acidity without vinegar.\nSugar goes in last, only as much as the raspberries need.",
            "captions": "48 HOURS · COLD\nCHAMOMILE · TANNIN\nMURRAY RIVER SALT\nSEMILLON · VERJUS\nSUGAR TO TASTE"
          }
        },
        "p_b2": {
          "type": "procbottle",
          "settings": {
            "code": "NON2",
            "accent": "#c8813a",
            "fruit": "pear",
            "bot": "kelp",
            "titles": "Caramelised\nTea & spice\nSea minerality\nVerjus pressed\nTasted to level",
            "bodies": "Pears cooked until their sugars darken, then steeped. Buttery body, no butter.\nBlack tea for structure, with clove, cardamom, star anise, ginger and peppercorn riding behind it.\nKombu and olive brine instead of a straight salt hit — savoury, oceanic depth.\nVerjus cuts the caramel so the body stays bright rather than syrupy.\nAgave and vanilla land it, tasted back against the spice.",
            "captions": "PEARS · CARAMELISED\nBLACK TEA · SPICE\nKOMBU · OLIVE BRINE\nSEMILLON · VERJUS\nAGAVE · VANILLA"
          }
        },
        "p_b3": {
          "type": "procbottle",
          "settings": {
            "code": "NON3",
            "accent": "#d8c25a",
            "fruit": "citrus",
            "bot": "quill",
            "titles": "Citrus in\nToasted cinnamon\nA pinch of salt\nVerjus pressed\nTasted to level",
            "bodies": "Oranges and yuzu, juiced and zested — the aromatic lift the whole drink is built around.\nCinnamon is toasted before it goes in. Warmth, and a dry savoury edge underneath the fruit.\nSalt holds the citrus down so it reads as a drink, not as juice.\nVerjus sits behind the yuzu — tart, never sharp.\nSugar to level, tasted against how sweet the oranges came in.",
            "captions": "ORANGE · YUZU\nCINNAMON · TOASTED\nSALT\nSEMILLON · VERJUS\nSUGAR TO TASTE"
          }
        },
        "p_b4": {
          "type": "procbottle",
          "settings": {
            "code": "NON5",
            "accent": "#c4455c",
            "fruit": "citrus",
            "bot": "flower",
            "titles": "Cooked down\nHibiscus in\nSalt & hops\nVerjus pressed\nTasted to level",
            "bodies": "Lemon cooked marmalade-style, then layered with lemon verbena, lemongrass and lemon myrtle.\nHibiscus for colour and grip; liquorice root and peppermint carry the menthol finish.\nSalt for salinity, with a whisper of hops for bitterness.\nVerjus keeps the citrus taut instead of round.\nSugar last, kept low so the florals stay dry.",
            "captions": "LEMON · MARMALADE\nHIBISCUS · LIQUORICE\nSALT · HOPS\nSEMILLON · VERJUS\nSUGAR TO TASTE"
          }
        },
        "p_b5": {
          "type": "procbottle",
          "settings": {
            "code": "NON7",
            "accent": "#8e2f3f",
            "fruit": "berry",
            "bot": "bean",
            "titles": "Stewed slowly\nCoffee in\nSalt & pepper\nVerjus pressed\nTasted to level",
            "bodies": "Cherries stewed down until they turn dark and jammy — the base note of the whole bottle.\nArabica coffee for tannin and depth, with garam masala, allspice and nutmeg behind it.\nSalt and pink peppercorn sharpen the dark fruit and stop it going sweet.\nVerjus lifts the stewed fruit back off the palate.\nBarely any sugar — the fruit already brought it.",
            "captions": "CHERRIES · STEWED\nARABICA · GARAM MASALA\nSALT · PINK PEPPER\nSEMILLON · VERJUS\nTASTED BACK"
          }
        },
        "p_b6": {
          "type": "procbottle",
          "settings": {
            "code": "NON9",
            "accent": "#6b4a82",
            "fruit": "berry",
            "bot": "oak",
            "titles": "Dark fruit\nOak & skin\nTamari & salt\nVerjus pressed\nTasted to level",
            "bodies": "Stanley plum, blackberry and Shiraz grape skin, with beetroot for earth and colour.\nFrench oak and grape skin build firm tannin; fir pine sits on the nose as forest floor.\nTamari for savoury depth alongside the salt — umami rather than seasoning.\nVerjus holds the dark fruit in line so it doesn't turn jammy.\nSugar and ancho chilli finish it: spice first, then length.",
            "captions": "PLUM · BLACKBERRY\nFRENCH OAK · PINE\nTAMARI · SALT\nSEMILLON · VERJUS\nSUGAR · ANCHO"
          }
        },
