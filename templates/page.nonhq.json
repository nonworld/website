          "type": "step",
          "settings": {
            "title": "You taste blind first",
            "body": "No labels, no story. Most people spend the first ten minutes deciding what it reminds them of."
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Then you taste the parts",
            "body": "Verjus on its own. Salt on its own. Cinnamon tannin on its own. The argument for each one, in the glass."
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Then food arrives",
