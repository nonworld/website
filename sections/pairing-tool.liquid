{% render 'section-style', section: section %}
{%- comment -%}
  Pairing — food → bottle.

  Three axes, each option carrying a score per bottle code. Scores are summed
  and the leading bottle wins, with a running "trace" that shows the reasoning
  rather than just the answer. The reverse flow (bottle → recipe) is a separate
  section, pairing-recipes.
{%- endcomment -%}

<div class="non-section" data-non-somm-root>
  <div class="non-section__head">
    <h1 class="non-section__title">{{ section.settings.heading }}</h1>
    <span class="non-section__more" data-non-pair-step>question 1 of {{ section.blocks | size }}</span>
  </div>

  {%- if section.settings.intro != blank -%}
    <p class="non-hero__blurb" style="margin-top:20px">{{ section.settings.intro }}</p>
  {%- endif -%}

  <div class="non-pair" style="margin-top:30px" data-non-pair>
    <div>
      <div class="non-pair__dots" data-non-pair-dots>
        {%- for block in section.blocks -%}
          <span class="non-pair__dot{% if forloop.first %} non-pair__dot--now{% endif %}"></span>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        <fieldset
          class="non-pair__axis"
          data-non-pair-axis="{{ forloop.index0 }}"
          style="border:0;padding:0;margin:0{% unless forloop.first %};display:none{% endunless %}"
          {{ block.shopify_attributes }}>
          <legend class="non-pair__q">{{ block.settings.question }}</legend>

          <div class="non-pair__opts">
            {%- assign options = block.settings.options | newline_to_br | split: '<br />' -%}
            {%- for option in options -%}
              {%- assign parts = option | strip | split: '|' -%}
              {%- if parts.size >= 2 -%}
                <button
                  type="button"
                  class="non-pair__opt"
                  data-non-pair-opt
                  data-scores="{{ parts[1] | strip | escape }}"
                  data-trace="{{ parts[2] | default: '' | strip | escape }}">
                  {{ parts[0] | strip }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endfor -%}

      <div data-non-pair-result hidden style="animation:rise .4s ease both">
        <div class="non-pair__q" data-non-pair-title></div>
        <p class="non-note" data-non-pair-body style="max-width:52ch"></p>
        <button type="button" class="non-btn non-btn--ghost" data-non-pair-reset style="margin-top:18px">
          Start again
        </button>
      </div>
    </div>

    <aside>
      <div class="non-mono non-eyebrow">Reasoning</div>
      <div class="non-pair__trace" data-non-pair-trace style="margin-top:14px">
        Answer the questions and the somm will show its working.
      </div>

      <div class="non-somm__picks" data-non-somm-picks hidden style="margin-top:22px"></div>
    </aside>
  </div>
</div>

{%- comment -%} Reasons keyed by bottle code, shown once a winner emerges. {%- endcomment -%}
<script type="application/json" data-non-pair-reasons>
  {
    {%- for block in section.blocks -%}
      {%- if block.type == 'reason' -%}
        {{ block.settings.code | upcase | json }}: {{ block.settings.reason | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  }
</script>

<script type="application/json" data-non-catalogue>
  {
    {%- for p in collections.all.products limit: 40 -%}
      {%- capture c %}{% render 'non-code', product: p %}{% endcapture -%}
      {{ c | json }}: {
        "title": {{ p.title | json }},
        "url": {{ p.url | json }},
        "image": {{ p.featured_image | image_url: width: 200 | json }},
        "price": {{ p.price | money | json }},
        "note": {{ p.metafields.custom.tastes | metafield_text | default: '' | json }},
        "variantId": {{ p.selected_or_first_available_variant.id | json }},
        "available": {{ p.available | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
</script>

<script src="{{ 'pairing.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Pairing tool",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's on the table?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Three questions. The somm shows its working rather than just naming a bottle."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "axis",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Options",
          "info": "One per line: Label | CODE:score,CODE:score | trace line. e.g. Starters | NON1:2,NON5:1 | Light plates, needs salinity."
        }
      ]
    },
    {
      "type": "reason",
      "name": "Bottle reason",
      "settings": [
        {
          "type": "text",
          "id": "code",
          "label": "Bottle code",
          "info": "e.g. NON1"
        },
        {
          "type": "textarea",
          "id": "reason",
          "label": "Why this bottle wins"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pairing tool"
    }
  ]
}
{% endschema %}
