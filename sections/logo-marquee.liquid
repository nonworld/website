{%- comment -%} re-synced 2026-08-02: the inline per-logo max-height removal had not been taken by Shopify {%- endcomment -%}
{% render 'section-style', section: section %}
{%- if section.blocks.size > 0 -%}
  <div class="non-poured">
    <div class="non-poured__label">{{ section.settings.heading }}</div>
    <div class="non-poured__track" aria-hidden="true">
      {%- for i in (1..2) -%}
        <div class="non-poured__set">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 300, format: 'webp'
                | image_tag:
                  loading: 'lazy',
                  alt: block.settings.name,
              }}
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.name | escape }}"
                loading="lazy"
>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    <ul class="visually-hidden">
      {%- for block in section.blocks -%}
        <li>{{ block.settings.name }}</li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Poured at",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Poured at"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "venue",
      "name": "Venue",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Logo URL",
          "info": "Used only when no image is uploaded."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Venue name"
        },
        {
          "type": "range",
          "id": "max_height",
          "label": "Max height",
          "min": 24,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 44,
          "info": "Wordmarks and lockups don't share an optical size — trim each one here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Poured at"
    }
  ],
  "max_blocks": 30
}
{% endschema %}
