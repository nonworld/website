{% render 'section-style', section: section %}
{%- comment -%}
  Shop — "the somm is the filter".

  The design scored every bottle against nine food occasions with a hardcoded
  tag table. Here the scores live on each product as metafield custom.food_tags
  (JSON: { "raw": 3, "seafood": 3, … }) and the per-occasion reasoning lives on
  custom.food_why (JSON: { "raw": "Salinity meets brine…" }).

  Filtering happens client-side over the rendered grid: the collection is nine
  or ten products, so there is no pagination to fight and no reason to round-
  trip. If the range grows past ~40 SKUs, move this to Search & Discovery
  filters instead.
{%- endcomment -%}

{%- comment -%}
  The design opens this page with a statement, not a label. The port rendered
  the collection title through .non-section__title — an 11px mono eyebrow — so
  the loudest thing on the shop page was the same size as a caption.
{%- endcomment -%}
<div class="non-collection-hero">
  <div>
    <div class="non-mono non-eyebrow">
      {{ section.settings.eyebrow | default: collection.title }}
    </div>
    <h1 class="non-collection-hero__title">
      {{ section.settings.heading | default: collection.title }}
    </h1>
  </div>
  {%- if section.settings.blurb != blank -%}
    <p class="non-collection-hero__blurb">{{ section.settings.blurb }}</p>
  {%- endif -%}
</div>

<div class="non-section">
  <div class="non-section__head">
    <span class="non-mono non-eyebrow">{{ section.settings.filter_label }}</span>
    <span class="non-section__more" data-non-count></span>
  </div>

  {%- if section.settings.show_filters -%}
    <div class="non-filters" role="group" aria-label="What's on the table">
      <button type="button" class="non-filter" data-non-filter="all" aria-pressed="true">Everything</button>
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="non-filter"
          data-non-filter="{{ block.settings.key }}"
          data-somm-line="{{ block.settings.somm_line | escape }}"
          aria-pressed="false"
          {{ block.shopify_attributes }}>
          {{ block.settings.label }}
        </button>
      {%- endfor -%}
    </div>

    <p class="non-somm-line" data-non-somm-line hidden></p>
  {%- endif -%}

  {%- comment -%}
    'Cheapest way in'. A solid CTA, deliberately the only filled control on the
    page, so the commit action does not read as another filter chip.
  {%- endcomment -%}
  {%- if section.settings.promo_product != blank -%}
    {%- assign promo = section.settings.promo_product -%}
    <div class="non-promo">
      <div class="non-promo__copy">
        <div class="non-mono non-eyebrow">{{ section.settings.promo_eyebrow }}</div>
        <div class="non-promo__title">
          {{ section.settings.promo_heading | default: promo.title }}
          {%- if section.settings.promo_show_price %} &mdash; {{ promo.price | money }}{% endif -%}
        </div>
        {%- if section.settings.promo_body != blank -%}
          <p class="non-promo__body">{{ section.settings.promo_body }}</p>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="non-promo__cta"
        data-non-add
        data-variant-id="{{ promo.selected_or_first_available_variant.id }}">
        {{ section.settings.promo_cta }}
      </button>
    </div>
  {%- endif -%}

  {%- if collection.products.size > 0 -%}
    <div
      class="non-grid non-grid--{{ section.settings.columns }} non-grid--ratio-{{ section.settings.image_ratio | default: 'square' }}"
      {% if section.settings.card_max >= 120 %}style="--non-card-max: {{ section.settings.card_max }}px"{% endif %}
      data-non-shelf
      data-dim="{{ section.settings.dim_level | default: 34 | divided_by: 100.0 }}"
      data-dim-enabled="{{ section.settings.dim_non_matches }}">
      {%- for product in collection.products -%}
        {%- comment -%} render is standalone-only, never inside {% liquid %} {%- endcomment -%}
        {%- capture code %}{% render 'non-code', product: product %}{% endcapture -%}
        {%- liquid
          # An empty-JSON literal cannot be written inline inside an output
          # tag: Liquid's lexer ignores string quoting when finding the end of
          # the tag, so a brace inside the literal truncates it mid-way and
          # Shopify rejects the whole file. Bind it here, where the tag
          # terminator is a percent-brace and braces are safe.
          assign empty_json = '{}'
          assign code = code | strip
          assign tags_json = product.metafields.custom.food_tags | metafield_text
          assign why_json = product.metafields.custom.food_why | metafield_text
          assign is_pour = false
          if code contains 'NON'
            assign is_pour = true
          endif
        -%}
        <div
          data-non-item
          data-code="{{ code | escape }}"
          data-is-pour="{{ is_pour }}"
          data-tags="{{ tags_json | default: empty_json | escape }}"
          data-why="{{ why_json | default: empty_json | escape }}">
          {% render 'product-card', product: product, show_add: section.settings.show_add %}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="non-note" style="margin-top:24px">Nothing in this collection yet.</p>
  {%- endif -%}

  {%- if paginate.pages > 1 -%}
    <nav class="non-mono non-eyebrow" style="margin-top:32px;display:flex;gap:14px" aria-label="Pagination">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
    </nav>
  {%- endif -%}
</div>

<script src="{{ 'collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Defaults to the collection title."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Sorted by what you're eating."
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Not by price. Not by colour. Tell the shelf what's on the table and it reorders itself — strongest match first, with the reason attached."
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter row label",
      "default": "Eating"
    },
    {
      "type": "header",
      "content": "Cheapest way in"
    },
    {
      "type": "product",
      "id": "promo_product",
      "label": "Promoted product",
      "info": "Leave empty to hide the band."
    },
    {
      "type": "text",
      "id": "promo_eyebrow",
      "label": "Promo eyebrow",
      "default": "Cheapest way in"
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Promo heading",
      "info": "Defaults to the product title."
    },
    {
      "type": "checkbox",
      "id": "promo_show_price",
      "label": "Show the price",
      "default": true
    },
    {
      "type": "textarea",
      "id": "promo_body",
      "label": "Promo body"
    },
    {
      "type": "text",
      "id": "promo_cta",
      "label": "Promo button",
      "default": "Add the mixed six"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show the somm food filter",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "tall",
          "label": "Tall (4:5)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_add",
      "label": "Show add to cart on cards",
      "default": true
    },
    {
      "type": "range",
      "id": "card_max",
      "label": "Card width",
      "min": 120,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 640,
      "info": "How wide a card may get. Drag left for smaller pictures."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "info": "Exact number of products per row on desktop.",
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "dim_non_matches",
      "label": "Fade bottles that don't answer",
      "default": true
    },
    {
      "type": "range",
      "id": "dim_level",
      "label": "Fade level",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 34,
      "info": "Whole percentages only — Shopify rejects decimal-step ranges on a floating-point divisibility check, which invalidates the section."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Food occasion",
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Key",
          "info": "Must match a key in the product's custom.food_tags metafield."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "somm_line",
          "label": "Somm line",
          "info": "The prose shown when this filter is active."
        }
      ]
    }
  ]
}
{% endschema %}

