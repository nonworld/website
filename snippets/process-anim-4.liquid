<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:900,&quot;height&quot;:420},&quot;sceneSeconds&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:6,&quot;min&quot;:3,&quot;max&quot;:12,&quot;step&quot;:0.5,&quot;unit&quot;:&quot;s&quot;,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Timing&quot;}}">
const PRODUCTS = [
  {
    code: "NON1", name: "NON1 — SALTED RASPBERRY & CHAMOMILE", accent: "#F1967E",
    fruit: "berry", bot: "flower",
    caps: ["48 HOURS · COLD", "CHAMOMILE · TANNIN", "MURRAY RIVER SALT", "SEMILLON · VERJUS", "SUGAR TO TASTE"],
    steps: [
      ["Cold steep", "48 hours of freeze-dried Tasmanian raspberries steeping cold. Freeze drying pulls 85% of the water out and leaves the flavour behind."],
