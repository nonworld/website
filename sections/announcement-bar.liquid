{% render 'section-style', section: section %}
{%- comment -%}
  Two block types. `message` is free merchant text. `free_shipping` resolves per
  market via snippets/free-shipping.liquid and renders NOTHING in a market with
  no confirmed free rate.

  It used to be a plain `message` block carrying the literal string
  "free shipping over $75", shown to every market — including the UK, where the
  real threshold is £50 and the symbol is not a dollar sign, and including CA,
  NZ and International, where no free rate is confirmed to exist at all.

  A block resolving to empty is skipped entirely rather than emitting a blank
  span, so the marquee does not develop a gap where the message used to be.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="non-announce">
    <div class="non-announce__track" aria-hidden="true">
      {%- comment -%}
        The track is duplicated so the -50% keyframe loops seamlessly. Screen
        readers get the plain list below instead.
      {%- endcomment -%}
      {%- for i in (1..2) -%}
        <div class="non-announce__set">
          {%- for j in (1..2) -%}
            {%- for block in section.blocks -%}
              {%- capture block_text -%}
                {%- if block.type == 'free_shipping' -%}
                  {%- render 'free-shipping', mode: 'text' -%}
                {%- else -%}
                  {{- block.settings.text -}}
                {%- endif -%}
              {%- endcapture -%}
              {%- assign block_text = block_text | strip -%}
              {%- if block_text != blank -%}
                <span {% if j == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block_text }}</span>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    <ul class="visually-hidden">
      {%- for block in section.blocks -%}
        {%- capture block_text -%}
          {%- if block.type == 'free_shipping' -%}
            {%- render 'free-shipping', mode: 'text' -%}
          {%- else -%}
            {{- block.settings.text -}}
          {%- endif -%}
        {%- endcapture -%}
        {%- assign block_text = block_text | strip -%}
        {%- if block_text != blank -%}
          <li>{{ block_text }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "0.0% ABV"
        }
      ]
    },
    {
      "type": "free_shipping",
      "name": "Free shipping (per market)",
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the free shipping threshold for the visitor's market, in that market's currency. Hidden entirely in markets with no free shipping rate configured. Thresholds are set in snippets/free-shipping.liquid, not here — there is no text to edit, deliberately, because a hardcoded amount was previously shown to every market at once."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "message",
        "settings": {
          "text": "0.0% ABV"
        }
      },
      {
        "type": "message",
        "settings": {
          "text": "chef made"
        }
      },
      {
        "type": "free_shipping"
      },
      {
        "type": "message",
        "settings": {
          "text": "vegan & gluten free"
        }
      }
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ]
}
{% endschema %}
