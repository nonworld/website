{% render 'section-style', section: section %}
{%- comment -%}
  Press, with the globe filling the space to its right.

  The globe is built by assets/globe.js into the empty div below — the markup
  is generated rather than written here because it is ~30 nodes of pure
  geometry (meridian rings, parallels, a canvas overlay and one label per
  city), none of which anyone would ever edit by hand.

  It only renders when the section is set to show it, and the section falls
  back to its original two-column layout when it is off.
{%- endcomment -%}

{%- liquid
  assign show_globe = section.settings.show_globe
  assign globe_class = 'non-press'
  if show_globe
    assign globe_class = 'non-press non-press--globe'
  endif
-%}

<div class="{{ globe_class }}">
  <div class="non-mono non-eyebrow">{{ section.settings.heading }}</div>

  {%- comment -%}
    TWO on screen, rotating through however many are added.

    The old press strip carried four quotes side by side and each one was a
    paragraph wide; two at a time gives each the room to be read. The rest are
    in the DOM from the start — rendered, not fetched — so the rotation costs
    nothing and the section degrades to a plain stack of every quote if the
    script never runs.

    aria-live is off deliberately: this rotates on a timer without the reader
    asking, and announcing each change would talk over them.
  {%- endcomment -%}
  <div
    class="non-press__list"
    data-non-press
    data-visible="2"
    data-interval="{{ section.settings.rotate_seconds | default: 7 | times: 1000 }}">
    {%- for block in section.blocks -%}
      <div class="non-press__item" data-non-press-item {{ block.shopify_attributes }}>
        <blockquote class="non-press__quote" style="margin:0">
          &ldquo;{{ block.settings.quote }}&rdquo;
        </blockquote>
        <div class="non-press__cite">{{ block.settings.source }}</div>
      </div>
    {%- endfor -%}
  </div>

  {%- if show_globe -%}
    <div
      class="non-globe"
      data-non-globe
      data-size="{{ section.settings.globe_size }}"
      data-lap="{{ section.settings.globe_lap }}"
      data-logo-lap="{{ section.settings.globe_logo_lap }}"
      {% if section.settings.globe_logo != blank %}
        data-logo="{{ section.settings.globe_logo | image_url: width: 240, format: 'webp' }}"
      {% else %}
        data-logo="{{ 'non-logotype.svg' | asset_url }}"
      {% endif %}
      style="--non-globe-box: {{ section.settings.globe_size | plus: 60 }}px"
      aria-hidden="true"></div>
  {%- endif -%}
</div>

{%- comment -%}
  The rotation loads whether or not the globe does — they are unrelated, and
  nesting it inside the globe condition meant the quotes only cycled on the
  one layout that happened to have the globe switched on.
{%- endcomment -%}
<script src="{{ 'press-rotate.js' | asset_url }}" defer></script>

{%- if show_globe -%}
  <script src="{{ 'globe.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Press",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Press"
    },
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Rotate every",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Two quotes show at a time and cycle through the rest. Long enough to finish reading the longer ones."
    },
    {
      "type": "header",
      "content": "Globe"
    },
    {
      "type": "checkbox",
      "id": "show_globe",
      "label": "Show the globe",
      "default": true,
      "info": "Sits to the right of the quotes. Pauses when scrolled off screen, and renders a single still frame for anyone using reduced motion."
    },
    {
      "type": "range",
      "id": "globe_size",
      "label": "Size",
      "min": 200,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "globe_lap",
      "label": "Seconds per rotation",
      "min": 10,
      "max": 90,
      "step": 2,
      "unit": "s",
      "default": 34
    },
    {
      "type": "range",
      "id": "globe_logo_lap",
      "label": "Seconds per logo sweep",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "s",
      "default": 9
    },
    {
      "type": "image_picker",
      "id": "globe_logo",
      "label": "Mark on the globe",
      "info": "Defaults to the NON logotype."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "source",
          "label": "Publication"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press"
    }
  ],
  "max_blocks": 30
}
{% endschema %}

