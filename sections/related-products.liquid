{% render 'section-style', section: section %}
{%- comment -%}
  "Goes well in a case with", rebuilt against the design.

  Horizontal cards — a 62x80 bottle shot beside the code, name and tasting
  note. The port used the vertical grid card from the shop, which is a
  different component doing a different job.

  Prefers the product's own custom.related (a list of product references,
  matching the design's hand-picked array), falling back to Shopify's
  recommendations.
{%- endcomment -%}

{%- liquid
  assign related = product.metafields.custom.related.value
  assign items = related
  if items == blank and recommendations.performed and recommendations.products_count > 0
    assign items = recommendations.products
  endif
-%}

{%- comment -%}
  The wrapper renders even with nothing in it.

  It used to sit inside the items-not-blank branch, which made the fetch URL
  unreachable in exactly the case that needed it: recommendations.performed is
  only true when Shopify renders this section through the Section Rendering
  API, so on a normal page load a product with no custom.related metafield had
  no items, therefore no wrapper, therefore no URL, therefore no fetch — and
  the section could never appear. The hook existed and nothing ever called it.
{%- endcomment -%}
<div
  class="non-section"
  data-non-recommendations
  {% if items == blank %}hidden{% endif %}
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
    <div class="non-mono non-eyebrow">{{ section.settings.heading }}</div>

    {%- comment -%}
      The SAME card as the shop grid and the homepage row.

      This band used a bespoke horizontal card — a 62x80 thumb beside the text —
      carried over from design-reference. Overridden deliberately on Aaron's
      instruction to apply the card principles to the PDP: the site now has one
      product card, square, on the photo bed, and a PDP showing bottles in a
      different component to every other page makes one product look like two.

      Nothing bespoke survives here, so a future change to product-card reaches
      this band rather than leaving it to drift.
    {%- endcomment -%}
    <div
      class="non-grid non-grid--{{ section.settings.columns }} non-grid--ratio-{{ section.settings.image_ratio | default: 'square' }}"
      style="--non-card-max: {{ section.settings.card_max | default: 380 }}px">
      {%- for item in items limit: section.settings.limit -%}
        {% render 'product-card', product: item, show_add: section.settings.show_add %}
      {%- endfor -%}
    </div>
  </div>

<script src="{{ 'related.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Related bottles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Goes well in a case with"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4",
      "info": "Exact number per row on desktop."
    },
    {
      "type": "range",
      "id": "card_max",
      "label": "Card width",
      "min": 120,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 380,
      "info": "Matches the shop grid and the homepage row at 380."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "tall", "label": "Tall (4:5)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_add",
      "label": "Show add button",
      "default": false
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ]
}
{% endschema %}
