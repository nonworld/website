{% render 'section-style', section: section %}
{%- comment -%}
  NONHQ — cellar door.

  A request, not a booking, and that is the whole design: someone tells you
  when they'd like to come and NON replies. No availability, no calendar, no
  app.

  It posts through Shopify's native contact form, which emails the store's
  contact address — hello@non.world — with the customer's address set as
  reply-to, so replying goes straight back to them. Nothing external is
  involved and there is no endpoint to keep alive.

  Every answer is prefixed into contact[body] as well as sent as its own
  field, because Shopify's notification email renders the body reliably and
  custom fields depend on the notification template.
{%- endcomment -%}

{%- comment -%}
  Everything the design has around the concierge, which the port never built:
  a hero, the practical facts, the three rooms, what actually happens, the
  press and two closing offers. The booking form was the only part that
  existed.
{%- endcomment -%}
{%- assign creds = section.blocks | where: 'type', 'credential' -%}
{%- if creds.size > 0 -%}
  {%- comment -%}
    The design's credential strip, same component as About's. Blocks rather than
    a fixed string so each page carries its own facts — Stockists leads with the
    venue count, NONHQ with opening hours.
  {%- endcomment -%}
  <div class="non-creds">
    {%- for b in creds -%}
      <span class="non-creds__item" {{ b.shopify_attributes }}>{{ b.settings.text }}</span>
    {%- endfor -%}
  </div>
{%- endif -%}

{%- comment -%}
  The hero sits ON a photograph in the design — a full-bleed image with the
  headline and blurb over it, not a headline on flat charcoal with pictures
  underneath. There was no image setting at all, which is why it could not be
  added from the editor.

  Without an image the hero keeps its flat treatment exactly as before, so an
  unset slot changes nothing rather than leaving a frame.
{%- endcomment -%}
{%- assign has_hero_image = false -%}
{%- if section.settings.hero_image != blank or section.settings.hero_image_url != blank -%}
  {%- assign has_hero_image = true -%}
{%- endif -%}

<div class="non-hq-hero{% if has_hero_image %} non-hq-hero--media{% endif %}">
  {%- if has_hero_image -%}
    <div class="non-hq-hero__bg" aria-hidden="true">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 2200, format: 'webp' | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800,1200,1600,2200', alt: '' }}
      {%- else -%}
        {% render 'cdn-image',
           url: section.settings.hero_image_url,
           alt: '',
           sizes: '100vw' %}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="non-hq-hero__inner">
    <div>
      <div class="non-mono non-eyebrow">{{ section.settings.hero_eyebrow }}</div>
      <h1 class="non-hq-hero__title">{{ section.settings.hero_heading }}</h1>
    </div>
    {%- if section.settings.hero_blurb != blank -%}
      <p class="non-hq-hero__lead">{{ section.settings.hero_blurb }}</p>
    {%- endif -%}
  </div>
</div>

{%- assign facts = section.blocks | where: 'type', 'fact' -%}
{%- if facts.size > 0 -%}
  <div class="non-hq-facts">
    {%- for b in facts -%}
      <div class="non-hq-fact" {{ b.shopify_attributes }}>
        <div class="non-mono non-eyebrow">{{ b.settings.label }}</div>
        <div class="non-hq-fact__body">{{ b.settings.body }}</div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{%- assign rooms = section.blocks | where: 'type', 'room' -%}
{%- if rooms.size > 0 -%}
  <div class="non-hq-rooms">
    {%- for b in rooms -%}
      <div class="non-hq-room" {{ b.shopify_attributes }}>
        {%- if b.settings.image != blank -%}
          {{ b.settings.image | image_url: width: 900, format: 'webp' | image_tag:
             loading: 'lazy', widths: '400,700,900', class: 'non-hq-room__img', alt: b.settings.title }}
        {%- elsif b.settings.image_url != blank -%}
          {% render 'cdn-image',
             url: b.settings.image_url,
             alt: b.settings.title,
             class: 'non-hq-room__img',
             sizes: '(min-width: 720px) 33vw, 100vw' %}
        {%- endif -%}
        <div class="non-hq-room__cap">
          <div class="non-hq-room__t">{{ b.settings.title }}</div>
          <div class="non-hq-room__s">{{ b.settings.subtitle }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

<div class="non-section">
  <div class="non-section__head">
    {%- comment -%}
      h2. The hero above is the page's h1 — this labels the booking tool.
    {%- endcomment -%}
    <h2 class="non-section__title">{{ section.settings.heading }}</h2>
  </div>

  {%- if section.settings.intro != blank -%}
    <p class="non-hero__blurb" style="margin-top:20px">{{ section.settings.intro }}</p>
  {%- endif -%}

  <div class="non-grid non-grid--4" style="margin-top:30px">
    {%- for block in section.blocks -%}
      {%- if block.type == 'experience' -%}
        <div {{ block.shopify_attributes }}>
          <div class="non-step__t">{{ block.settings.title }}</div>
          <p class="non-step__b">{{ block.settings.body }}</p>
          <div class="non-mono non-eyebrow" style="margin-top:10px">{{ block.settings.meta }}</div>
          <div class="non-card__note" style="margin-top:6px">{{ block.settings.price }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<div class="non-section" style="border-top:1px solid var(--non-line)">
  <div class="non-section__head">
    <h2 class="non-section__title">{{ section.settings.form_heading }}</h2>
  </div>

  {%- form 'contact', class: 'non-hq-form' -%}
    {%- if form.posted_successfully? -%}
      <p class="non-note" style="margin-top:22px">{{ section.settings.success_message }}</p>
    {%- else -%}
      {%- if form.errors -%}
        <p class="non-error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="non-grid non-grid--3" style="margin-top:24px;gap:18px">
        <div>
          <label class="non-label" for="hq-name">Name</label>
          <input class="non-field" type="text" id="hq-name" name="contact[name]" required>
        </div>

        <div>
          <label class="non-label" for="hq-email">Email</label>
          <input class="non-field" type="email" id="hq-email" name="contact[email]" required>
        </div>

        <div>
          <label class="non-label" for="hq-size">How many</label>
          <input class="non-field" type="number" id="hq-size" name="contact[party_size]" min="1" max="40">
        </div>

        <div>
          <label class="non-label" for="hq-exp">Experience</label>
          <select class="non-field" id="hq-exp" name="contact[experience]">
            {%- for block in section.blocks -%}
              {%- if block.type == 'experience' -%}
                <option value="{{ block.settings.title | escape }}">{{ block.settings.title }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </div>

        <div>
          <label class="non-label" for="hq-date">Preferred date</label>
          <input class="non-field" type="date" id="hq-date" name="contact[preferred_date]">
        </div>

        <div>
          <label class="non-label" for="hq-window">Time of day</label>
          <select class="non-field" id="hq-window" name="contact[preferred_window]">
            <option value="A morning">A morning</option>
            <option value="Around lunch">Around lunch</option>
            <option value="Afternoon">Afternoon</option>
            <option value="Early evening">Early evening</option>
          </select>
        </div>
      </div>

      <div style="margin-top:18px">
        <label class="non-label" for="hq-body">Anything we should know</label>
        <textarea class="non-field" id="hq-body" name="contact[body]" rows="4"
          placeholder="Dietaries, occasion, whether anyone needs converting."></textarea>
      </div>

      {%- comment -%}
        Gives the notification a subject that can be filtered on in the
        hello@ inbox, rather than every request arriving as "New message".
      {%- endcomment -%}
      <input
        type="hidden"
        name="contact[subject]"
        value="NONHQ booking request">

      <p class="non-mono non-eyebrow" style="margin-top:16px;letter-spacing:.12em">
        Goes to {{ shop.email | default: 'hello@non.world' }}
      </p>

      <button type="submit" class="non-btn" style="margin-top:20px">
        {{ section.settings.submit_label }}
      </button>

      <p class="non-mono non-eyebrow" style="margin-top:14px;letter-spacing:.12em">
        {{ section.settings.form_note }}
      </p>
    {%- endif -%}
  {%- endform -%}
</div>


{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- if steps.size > 0 -%}
  {%- comment -%}
    The design lays this out as 160px 1fr — the label in its own left column
    with the steps STACKED beside it, each step 44px 1fr. The build put the
    label above and ran the three steps across in repeat(3, 1fr), which reads
    as three parallel things rather than one sequence, and is the main reason
    the page did not feel like the design.

    The label moves into the grid rather than sitting in .non-section__head,
    because the head is a full-width band and cannot become a column.
  {%- endcomment -%}
  <div class="non-section non-hq-happens">
    <h2 class="non-section__title non-hq-happens__label">{{ section.settings.steps_label }}</h2>

    <div class="non-hq-steps">
      {%- for b in steps -%}
        <div class="non-hq-step" {{ b.shopify_attributes }}>
          <div class="non-hq-step__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <div>
            <div class="non-hq-step__t">{{ b.settings.title }}</div>
            <p class="non-hq-step__b">{{ b.settings.body }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- assign quotes = section.blocks | where: 'type', 'quote' -%}
{%- if quotes.size > 0 -%}
  <div class="non-press">
    <div class="non-mono non-eyebrow">{{ section.settings.press_label }}</div>
    <div class="non-press__list">
      {%- for b in quotes -%}
        <div {{ b.shopify_attributes }}>
          <blockquote class="non-press__quote" style="margin:0">&ldquo;{{ b.settings.quote }}&rdquo;</blockquote>
          <div class="non-press__cite">{{ b.settings.source }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- assign closers = section.blocks | where: 'type', 'closer' -%}
{%- if closers.size > 0 -%}
  <div class="non-about-ctas">
    {%- comment -%}
      Same component as the About page's closing CTAs, so it reuses that
      background treatment rather than growing a second one: .non-about-cta__bg
      for the image, __inner for the content above it, and --media to switch on
      the scrim. Without an image the card keeps its flat panel, which is what
      shipped before, so an unset slot is a no-op rather than a hole.
    {%- endcomment -%}
    {%- for b in closers -%}
      {%- assign has_bg = false -%}
      {%- if b.settings.image != blank or b.settings.image_url != blank -%}
        {%- assign has_bg = true -%}
      {%- endif -%}

      <div class="non-about-cta{% if forloop.last and has_bg == false %} non-about-cta--solid{% endif %}{% if has_bg %} non-about-cta--media{% endif %}" {{ b.shopify_attributes }}>
        {%- if has_bg -%}
          <div class="non-about-cta__bg" aria-hidden="true">
            {%- if b.settings.image != blank -%}
              {{ b.settings.image | image_url: width: 1400, format: 'webp' | image_tag: loading: 'lazy', widths: '600,900,1400', alt: '' }}
            {%- else -%}
              {% render 'cdn-image',
                 url: b.settings.image_url,
                 alt: '',
                 sizes: '(min-width: 720px) 50vw, 100vw' %}
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="non-about-cta__inner">
          <div class="non-about-cta__title">{{ b.settings.title }}</div>
          <p class="non-about-cta__body">{{ b.settings.body }}</p>
          {%- if b.settings.label != blank -%}
            <a class="non-about-cta__link" href="{{ b.settings.url | default: '/' }}">{{ b.settings.label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NONHQ concierge",
  "settings": [
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Cheltenham, Victoria · open Thu–Sun"
