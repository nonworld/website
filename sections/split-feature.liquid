{% render 'section-style', section: section %}
<div class="non-split"{% if section.settings.max_height > 0 %} style="--non-split-max: {{ section.settings.max_height }}px"{% endif %}>
  {%- for block in section.blocks -%}
    {%- assign alt_text = block.settings.image_alt | default: block.settings.title -%}
    <div class="non-split__cell" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1200, format: 'webp'
          | image_tag: loading: 'lazy', widths: '600,900,1200', class: 'non-split__img', alt: alt_text
        }}
      {%- elsif block.settings.image_url != blank -%}
        {% render 'cdn-image',
           url: block.settings.image_url,
           alt: alt_text,
           class: 'non-split__img',
           sizes: '(min-width: 860px) 50vw, 100vw' %}
      {%- else -%}
        {%- comment -%}
          A visible placeholder rather than nothing. An empty panel reads as a
          layout bug; a placeholder reads as "an image belongs here", which is
          what it is.
        {%- endcomment -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}

      <div class="non-split__body">
        <div class="non-split__title">{{ block.settings.title }}</div>
        <p class="non-split__text">{{ block.settings.text }}</p>
        {%- if block.settings.link_label != blank -%}
          <a class="non-split__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Split feature",
  "max_blocks": 2,
  "settings": [
    {
      "type": "range",
      "id": "max_height",
      "label": "Maximum image height",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 0,
      "info": "Caps how tall the pictures may grow on a wide screen. 0 leaves them sized by the shape above."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "cell",
      "name": "Panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the image URL below."
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL",
          "info": "Used when no image is picked. Points at an image already on the store's CDN."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Describes the photo for screen readers. Falls back to the title."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split feature"
    }
  ]
}
{% endschema %}

