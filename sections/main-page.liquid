{% render 'section-style', section: section %}
<div class="non-section">
  <div class="non-section__head">
    <h1 class="non-section__title">{{ page.title }}</h1>
  </div>
  {% render 'page-header-image', section: section %}

  <div class="non-rte" style="margin-top:30px">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    },
    {
      "type": "header",
      "content": "Header image"
    },
    {
      "type": "checkbox",
      "id": "show_header_image",
      "label": "Show header image",
      "default": true,
      "info": "Draws a placeholder until an image is set, as a reminder to replace it."
    },
    {
      "type": "image_picker",
      "id": "header_image",
      "label": "Header image"
    },
    {
      "type": "text",
      "id": "header_image_url",
      "label": "Header image URL",
      "info": "Used only when no image is uploaded."
    },
    {
      "type": "text",
      "id": "header_image_alt",
      "label": "Header image alt text"
    },
    {
      "type": "select",
      "id": "header_image_ratio",
      "label": "Header image shape",
      "options": [
        {
          "value": "21 / 9",
          "label": "Letterbox (21:9)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3 / 1",
          "label": "Panorama (3:1)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        }
      ],
      "default": "21 / 9"
    }
  ]
}
{% endschema %}
