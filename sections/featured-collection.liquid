{%- liquid
  assign coll = section.settings.collection | default: collections[settings.core_range_collection]
  assign limit = section.settings.limit | default: 4
-%}

<div class="non-section">
  <div class="non-section__head">
    <h2 class="non-section__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a class="non-section__more" href="{{ section.settings.link_url | default: coll.url }}">
        {{ section.settings.link_label }} &rarr;
      </a>
    {%- endif -%}
  </div>

  {%- if coll.products.size > 0 -%}
    <div class="non-grid non-grid--{{ section.settings.columns }} non-grid--ratio-{{ section.settings.image_ratio | default: 'portrait' }}">
      {%- for product in coll.products limit: limit -%}
        {% render 'product-card', product: product, show_add: section.settings.show_add %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="non-note" style="margin-top:24px">
      Pick a collection for this section in the theme editor.
    </p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Core range" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "info": "A maximum. Very wide screens fit more rather than stretching each card.",
      "default": "4"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "tall", "label": "Tall (4:5)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_add", "label": "Show add to cart on cards", "default": false },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All bottles" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
