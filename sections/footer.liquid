{% render 'section-style', section: section %}
<footer class="non-footer" role="contentinfo">
  <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>

  <span class="non-footer__links">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}

    {%- if settings.social_instagram != blank -%}
      <a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">{{ section.settings.instagram_label }}</a>
    {%- endif -%}

    {%- if section.settings.show_lotto_link -%}
      <button type="button" class="non-footer__button" data-non-lotto-open>{{ section.settings.lotto_label }}</button>
    {%- endif -%}

    {%- comment -%}
      Behind a setting rather than deleted. The address is still in Theme
      settings and still used elsewhere; this controls whether the FOOTER
      prints it. Deleting the markup would have made putting it back a code
      change rather than a checkbox.
    {%- endcomment -%}
    {%- if section.settings.show_email and settings.contact_email != blank -%}
      <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
    {%- endif -%}
  </span>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_lotto_link",
      "label": "Show the NON Lotto link",
      "default": true,
      "info": "Lets anyone re-open the scratch card after they've dismissed it."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show contact email",
      "default": false
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Instagram link text",
      "default": "Instagram"
    },
    {
      "type": "text",
      "id": "lotto_label",
      "label": "NON Lotto link text",
      "default": "NON Lotto"
    }
  ]
}
{% endschema %}
