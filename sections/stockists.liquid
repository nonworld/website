{% render 'section-style', section: section %}
{%- comment -%}
  Stockists — sourced from find.non.world.

  The design shipped twelve hand-written venues. The real feed is
  find.non.world/api/stockists: ~2,200 currently-stocking venues across AU, US
  and UK, rebuilt off the Monday accounts pipeline.

  That endpoint is already the public, sanitised surface — the middleware in
  the maps project locks every host except map.non.world down to it, and the
  payload carries only venue-public fields (name, coords, suburb, region, and a
  neutral Google category). No churn state, no ROS, no rep, no order dates.
  CORS is open specifically so it can be embedded on the marketing site, so the
  theme calls it directly from the browser; nothing proxies and no key is
  needed.

  Curated blocks still exist and render above the live list as a featured
  shortlist — use them for the rooms worth naming, not for coverage.
{%- endcomment -%}

{%- liquid
  assign endpoint = section.settings.endpoint | default: 'https://find.non.world/api/stockists'
  assign find_url = section.settings.find_url | default: 'https://find.non.world'
-%}

{%- comment -%}
  The design opens with a statement and a live count, then closes with two
  offers: become a stockist, or skip the trip and buy direct. The port had the
  tool and nothing around it — the page answered "where" and never "what if
  the answer is nowhere near me".
{%- endcomment -%}
{%- assign creds = section.blocks | where: 'type', 'credential' -%}
{%- if creds.size > 0 -%}
  {%- comment -%}
    The design's credential strip, same component as About's. Blocks rather than
    a fixed string so each page carries its own facts — Stockists leads with the
    venue count, NONHQ with opening hours.
  {%- endcomment -%}
  <div class="non-creds">
    {%- for b in creds -%}
      <span class="non-creds__item" {{ b.shopify_attributes }}>{{ b.settings.text }}</span>
    {%- endfor -%}
  </div>
{%- endif -%}

<div class="non-stock-hero">
  <div>
    <div class="non-mono non-eyebrow" data-non-hero-count>{{ section.settings.eyebrow }}</div>
    <h1 class="non-stock-hero__title">{{ section.settings.hero_heading }}</h1>
  </div>
  {%- if section.settings.hero_blurb != blank -%}
    <p class="non-stock-hero__lead">{{ section.settings.hero_blurb }}</p>
  {%- endif -%}
</div>

<div
  class="non-section"
  data-non-stockists
  data-endpoint="{{ endpoint }}"
  data-default-region="{{ section.settings.default_region }}"
  data-list-limit="{{ section.settings.list_limit }}">
  <div class="non-section__head">
    {%- comment -%}
      h2, not h1. The page hero above carries the h1 — this is the tool's own
      label, and two h1 elements on a page is the exact bug flagged on Pairing.
    {%- endcomment -%}
    <h2 class="non-section__title">{{ section.settings.heading }}</h2>
    <span class="non-section__more" data-non-venue-count>Loading…</span>
  </div>

  {%- if section.settings.intro != blank -%}
    <p class="non-hero__blurb" style="margin-top:20px">{{ section.settings.intro }}</p>
  {%- endif -%}

  <form class="non-somm" style="margin-top:26px;max-width:520px" data-non-venue-search>
    <div class="non-somm__bar">
      <span class="non-somm__caret" aria-hidden="true">&gt;</span>
      <label class="visually-hidden" for="venue-q-{{ section.id }}">Search stockists</label>
      <input
        id="venue-q-{{ section.id }}"
        class="non-somm__input"
        type="search"
        autocomplete="off"
        data-non-venue-query
        placeholder="{{ section.settings.search_placeholder | escape }}">
      <button type="submit" class="non-somm__submit">Search</button>
    </div>
  </form>

  <div class="non-filters" role="group" aria-label="Venue type">
    <button type="button" class="non-filter" data-non-venue-filter="all" aria-pressed="true">Everything</button>
    <button type="button" class="non-filter" data-non-venue-filter="restaurant" aria-pressed="false">Restaurants</button>
    <button type="button" class="non-filter" data-non-venue-filter="bar" aria-pressed="false">Bars &amp; pubs</button>
    <button type="button" class="non-filter" data-non-venue-filter="retail" aria-pressed="false">Retail</button>
  </div>

  <div class="non-filters" style="margin-top:10px" role="group" aria-label="Region">
    <button type="button" class="non-filter" data-non-venue-region="all" aria-pressed="true">Worldwide</button>
    <button type="button" class="non-filter" data-non-venue-region="AU" aria-pressed="false">Australia</button>
    <button type="button" class="non-filter" data-non-venue-region="UK" aria-pressed="false">UK</button>
    <button type="button" class="non-filter" data-non-venue-region="US" aria-pressed="false">US</button>
  </div>

  <div class="non-stockists" style="margin-top:26px">
    <div class="non-stockists__list">
      {%- comment -%}
        Filtered by type, not `section.blocks`. The credential strip above uses
        blocks too, and an unfiltered loop rendered them here as venues with no
        address — the exact failure the `where` filter exists to prevent.
      {%- endcomment -%}
      {%- assign venues = section.blocks | where: 'type', 'venue' -%}
      {%- if venues.size > 0 -%}
        <div class="non-mono non-eyebrow">{{ section.settings.featured_heading }}</div>
        <div style="margin-bottom:26px">
          {%- for block in venues -%}
            <div class="non-venue" {{ block.shopify_attributes }}>
              <div class="non-venue__name">{{ block.settings.name }}</div>
              <div class="non-venue__addr">{{ block.settings.address }}</div>
              {%- if block.settings.pours != blank -%}
                <div class="non-venue__pours">{{ block.settings.pours }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="non-stock-listhead">
        <div class="non-mono non-eyebrow" data-non-venue-list-heading>Stockists</div>
        {%- if section.settings.sort_note != blank -%}
          <span class="non-mono non-eyebrow non-stock-sort" data-non-venue-sort hidden>
            {{ section.settings.sort_note }}
          </span>
        {%- endif -%}
      </div>

      <div data-non-venues>
        <p class="non-note" style="padding:20px 0">Loading stockists…</p>
      </div>

      {%- comment -%}
        The empty state. The design answers "nothing near me" with two routes out
        rather than a dead end, so both are here and both are editable. Hidden
        until stockists.js knows the result set is empty — it toggles this rather
        than writing a single line of text, which is all it used to do.
      {%- endcomment -%}
      {%- if section.settings.empty_heading != blank -%}
        <div class="non-stock-empty" data-non-venue-empty hidden>
          <div class="non-stock-empty__title">{{ section.settings.empty_heading }}</div>
          {%- if section.settings.empty_body != blank -%}
            <p class="non-stock-empty__body">{{ section.settings.empty_body }}</p>
          {%- endif -%}
          <div class="non-stock-empty__acts">
            {%- if section.settings.empty_cta != blank -%}
              <a class="non-btn non-btn--ghost" href="{{ section.settings.find_url | default: '#' }}">
                {{ section.settings.empty_cta }}
              </a>
            {%- endif -%}
            {%- if section.settings.ship_cta != blank -%}
              <a class="non-btn" href="{{ section.settings.ship_url | default: '/collections/all' }}">
                {{ section.settings.ship_cta }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <button
        type="button"
        class="non-btn non-btn--ghost"
        data-non-venue-more
        style="margin-top:18px"
        hidden>
        Show more
      </button>

      <p class="non-error" data-non-venue-error hidden></p>
    </div>

    {%- if section.settings.show_map -%}
      <div class="non-map" data-non-map></div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Defaulted here rather than in the schema: Shopify's `url` setting type
    rejects a "default" key outright, and rejects the whole file with it.
  {%- endcomment -%}
  {%- comment -%}
    "Can't find it nearby?" — the design's answer to a search that came back
    thin: ask the customer to nominate their local rather than leaving them with
    nothing to do. Sits between the results and the two offers, as in the design.
  {%- endcomment -%}
  {%- if section.settings.nominate_heading != blank -%}
    <div class="non-stock-nominate">
      {%- if section.settings.nominate_label != blank -%}
        <div class="non-mono non-eyebrow">{{ section.settings.nominate_label }}</div>
      {%- endif -%}
      <div class="non-stock-nominate__title">{{ section.settings.nominate_heading }}</div>
      {%- if section.settings.nominate_body != blank -%}
        <p class="non-stock-nominate__body">{{ section.settings.nominate_body }}</p>
      {%- endif -%}
      {%- if section.settings.nominate_cta != blank -%}
        <a class="non-btn" href="{{ section.settings.nominate_url | default: '/pages/trade' }}">
          {{ section.settings.nominate_cta }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Two offers, side by side, for when the map comes up empty. {%- endcomment -%}
  {%- if section.settings.trade_heading != blank or section.settings.direct_heading != blank -%}
    <div class="non-stock-offers">
      {%- if section.settings.trade_heading != blank -%}
        <div class="non-stock-offer">
          <div class="non-mono non-eyebrow">{{ section.settings.trade_label }}</div>
          <div class="non-stock-offer__title">{{ section.settings.trade_heading }}</div>
          <p class="non-stock-offer__body">{{ section.settings.trade_body }}</p>
          {%- if section.settings.trade_cta != blank -%}
            <a class="non-stock-offer__cta" href="{{ section.settings.trade_url | default: '/pages/contact' }}">
              {{ section.settings.trade_cta }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.direct_heading != blank -%}
        <div class="non-stock-offer non-stock-offer--solid">
          <div class="non-mono non-eyebrow">{{ section.settings.direct_label }}</div>
          <div class="non-stock-offer__title">{{ section.settings.direct_heading }}</div>
          <p class="non-stock-offer__body">{{ section.settings.direct_body }}</p>
          {%- if section.settings.direct_cta != blank -%}
            <a class="non-stock-offer__cta" href="{{ section.settings.direct_url | default: '/collections/the-range' }}">
              {{ section.settings.direct_cta }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <p class="non-note" style="margin-top:28px">
    {{ section.settings.find_prompt }}
    <a href="{{ find_url }}" style="text-decoration:underline">
      {{ section.settings.find_label }}
    </a>
  </p>
</div>

{%- if section.settings.show_map -%}
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin="">
  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
    defer></script>
{%- endif -%}
<script src="{{ 'stockists.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Stockists",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stockists"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Headline",
      "default": "Find it poured near you."
    },
    {
      "type": "textarea",
      "id": "hero_blurb",
      "label": "Blurb",
      "default": "Search the full live directory — restaurants, bars and retailers, updated weekly."
    },
    {
      "type": "text",
      "id": "trade_label",
      "label": "Trade label",
      "default": "Trade"
    },
    {
      "type": "text",
      "id": "trade_heading",
      "label": "Trade heading",
      "default": "Stock NON"
    },
    {
      "type": "textarea",
      "id": "trade_body",
      "label": "Trade body",
      "default": "Restaurants, bars and retailers. Tell us where you are and we will put you in touch with the right distributor."
    },
    {
      "type": "text",
      "id": "trade_cta",
      "label": "Trade button",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "trade_url",
      "label": "Trade link"
    },
    {
      "type": "text",
      "id": "direct_label",
      "label": "Direct label",
      "default": "Or skip the trip"
    },
    {
      "type": "text",
      "id": "direct_heading",
      "label": "Direct heading",
      "default": "Have it delivered"
    },
    {
      "type": "textarea",
      "id": "direct_body",
      "label": "Direct body",
      "default": "The full range ships direct, and free over $75."
    },
    {
      "type": "text",
      "id": "direct_cta",
      "label": "Direct button",
      "default": "Shop the range"
    },
    {
      "type": "url",
      "id": "direct_url",
      "label": "Direct link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where to find it"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Every venue currently pouring or stocking NON, live from our field map."
    },
    {
      "type": "url",
      "id": "endpoint",
      "label": "Stockist feed",
      "info": "Defaults to https://find.non.world/api/stockists. Public and sanitised — no key required."
    },
    {
      "type": "select",
      "id": "default_region",
      "label": "Open on",
      "options": [
        {
          "value": "all",
          "label": "Worldwide"
        },
        {
          "value": "AU",
          "label": "Australia"
        },
        {
          "value": "UK",
          "label": "UK"
        },
        {
          "value": "US",
          "label": "US"
        }
      ],
      "default": "all"
    },
    {
      "type": "range",
      "id": "list_limit",
      "label": "Venues listed per page",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 30,
      "info": "The map always shows every match; this only caps the written list."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Suburb, city or venue name"
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Show the map",
      "default": true
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Featured heading",
      "default": "Worth the trip"
    },
    {
      "type": "url",
      "id": "find_url",
      "label": "Full map URL",
      "info": "Defaults to https://find.non.world"
    },
    {
      "type": "text",
      "id": "find_prompt",
      "label": "Full map prompt",
      "default": "Looking for somewhere not listed?"
    },
    {
      "type": "text",
      "id": "find_label",
      "label": "Full map label",
      "default": "Open the full map at find.non.world"
    },
    {
      "type": "text",
      "id": "sort_note",
      "label": "Sort note",
      "default": "Sorted by distance"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty heading",
      "default": "Nothing listed there yet."
    },
    {
      "type": "textarea",
      "id": "empty_body",
      "label": "Empty body",
      "default": "The full directory updates weekly and covers more than this preview does — try it on find.non.world, or have a bottle shipped to you instead."
    },
    {
      "type": "text",
      "id": "empty_cta",
      "label": "Empty CTA (directory)",
      "default": "Search find.non.world"
    },
    {
      "type": "text",
      "id": "ship_cta",
      "label": "Empty CTA (ship)",
      "default": "Ship to me"
    },
    {
      "type": "url",
      "id": "ship_url",
      "label": "Ship link"
    },
    {
      "type": "text",
      "id": "nominate_label",
      "label": "Nominate label",
      "default": "Not stocked near you"
    },
    {
      "type": "text",
      "id": "nominate_heading",
      "label": "Nominate heading",
      "default": "Can't find it nearby?"
    },
    {
      "type": "textarea",
      "id": "nominate_body",
      "label": "Nominate body",
      "default": "Tell your local we exist. Send them the trade sheet in two taps — most venues list within a month."
    },
    {
      "type": "text",
      "id": "nominate_cta",
      "label": "Nominate CTA",
      "default": "Send the trade sheet"
    },
    {
      "type": "url",
      "id": "nominate_url",
      "label": "Nominate link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "blocks": [
    {
      "type": "venue",
      "name": "Featured venue",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "pours",
          "label": "What they pour"
        }
      ]
    },
    {
      "type": "credential",
      "name": "Credential",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "0.0% abv"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stockists"
    }
  ],
  "max_blocks": 30
}
{% endschema %}
