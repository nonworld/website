<div class="non-split">
  {%- for block in section.blocks -%}
    {%- assign alt_text = block.settings.image_alt | default: block.settings.title -%}
    <div class="non-split__cell" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', widths: '600,900,1200', alt: alt_text
        }}
      {%- elsif block.settings.image_url != blank -%}
        <img src="{{ block.settings.image_url }}" alt="{{ alt_text | escape }}" loading="lazy">
      {%- else -%}
        {%- comment -%}
          A visible placeholder rather than nothing. An empty panel reads as a
          layout bug; a placeholder reads as "an image belongs here", which is
          what it is.
        {%- endcomment -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}

      <div class="non-split__body">
        <div class="non-split__title">{{ block.settings.title }}</div>
        <p class="non-split__text">{{ block.settings.text }}</p>
        {%- if block.settings.link_label != blank -%}
          <a class="non-split__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Split feature",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "cell",
      "name": "Panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the image URL below."
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL",
          "info": "Used when no image is picked. Points at an image already on the store's CDN."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Describes the photo for screen readers. Falls back to the title."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split feature"
    }
  ]
}
{% endschema %}

