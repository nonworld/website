      "label": "Headline",
      "default": "The world's first 0.0% cellar door."
    },
    {
      "type": "textarea",
      "id": "hero_blurb",
      "label": "Blurb",
      "default": "Nine bottles, a working kitchen and the people who make it. Tell the concierge who's coming and it books the right room."
    },
    {
      "type": "text",
      "id": "steps_label",
      "label": "What happens label",
      "default": "What happens"
    },
    {
      "type": "text",
      "id": "press_label",
      "label": "Press label",
      "default": "Press"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NONHQ"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "The world's first non-alcoholic cellar door. Tastings, tours and workshops in Cheltenham, VIC."
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Request a time"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Send the request"
    },
    {
      "type": "text",
      "id": "form_note",
      "label": "Form note",
      "default": "We confirm by email, usually same day."
    },
