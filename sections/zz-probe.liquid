<div></div>
{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "checkbox", "id": "show_filters", "label": "Show the somm food filter", "default": true },
    { "type": "checkbox", "id": "show_add", "label": "Show add to cart on cards", "default": true },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "dim_non_matches", "label": "Fade bottles that don't answer", "default": true },
    {
      "type": "range",
      "id": "dim_level",
      "label": "Fade level",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Food occasion",
      "settings": [
        { "type": "text", "id": "key", "label": "Key" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "textarea", "id": "somm_line", "label": "Somm line" }
      ]
    }
  ]
}
{% endschema %}
