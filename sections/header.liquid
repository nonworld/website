{% render 'section-style', section: section %}
<header class="non-header" role="banner">
  <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
    {%- if settings.logo != blank -%}
      <img
        src="{{ settings.logo | image_url: width: 400, format: 'webp' }}"
        alt="{{ shop.name | escape }}"
        class="non-header__logo"
        style="height: {{ settings.logo_height | default: '19px' }}"
        width="{{ settings.logo.width }}"
        height="{{ settings.logo.height }}">
    {%- else -%}
      {%- comment -%}
        Falls back to the logotype bundled in assets/ so the header is correct
        before anyone uploads anything in the theme editor. The file is the
        brand ink (#231F20); the header inverts it to sit on the dark shell.
      {%- endcomment -%}
      <img
        src="{{ 'non-logotype.svg' | asset_url }}"
        alt="{{ shop.name | escape }}"
        class="non-header__logo"
        style="height: {{ settings.logo_height | default: '19px' }}">
    {%- endif -%}
  </a>

  <nav class="non-header__nav" role="navigation" aria-label="Primary">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
    {%- if section.settings.show_localization -%}
      {% render 'localization-picker', id: 'hdr', compact: true %}
    {%- endif -%}
  </nav>

  {%- comment -%}
    Mobile menu. Six links in a sideways-scrolling strip fitted 225px of a
    361px nav on a 375px screen, so two thirds of the site was reachable only
    by a swipe nobody is told about. The strip is hidden below 860 and this
    takes over.

    The button is always in the markup and hidden by CSS above 860 rather than
    rendered conditionally, because Liquid cannot know the viewport and a
    server-rendered guess would be wrong for half of visitors.

    The panel repeats the same link_list, so there is ONE menu to edit in the
    theme editor and no second list to drift from the first.
  {%- endcomment -%}
  <button
    type="button"
    class="non-header__menu"
    data-non-menu-open
    aria-expanded="false"
    aria-controls="non-menu-{{ section.id }}">
    {{ section.settings.menu_label | default: 'Menu' }}
  </button>

  <button type="button" class="non-header__cart" data-non-cart-open data-non-cart-count>
    {{ 'sections.header.cart_count' | t: count: cart.item_count }}
  </button>
</header>

<div class="non-menu" id="non-menu-{{ section.id }}" data-non-menu hidden>
  <div class="non-menu__head">
    <span class="non-mono non-menu__eyebrow">{{ section.settings.menu_label | default: 'Menu' }}</span>
    <button type="button" class="non-menu__close" data-non-menu-close aria-label="{{ section.settings.close_label | default: 'Close' | escape }}">&times;</button>
  </div>
  <nav class="non-menu__nav" role="navigation" aria-label="Primary, mobile">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  </nav>
  {%- if section.settings.show_localization -%}
    {% render 'localization-picker', id: 'drawer' %}
  {%- endif -%}
</div>
<script src="{{ 'menu.js' | asset_url }}" defer></script>
{%- if section.settings.show_localization -%}
  <script src="{{ 'localization.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "menu_label",
      "label": "Mobile menu button",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Mobile menu close label",
      "default": "Close"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country/region picker",
      "default": true,
      "info": "Posts to Shopify's own localization endpoint. The language list only appears once a second language is published."
    }
  ]
}
{% endschema %}
