{% render 'section-style', section: section %}
<div class="non-section">
  {%- if section.settings.eyebrow != blank -%}
    <div class="non-mono non-eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <h2 class="non-hero__title" style="font-size:clamp(30px,4vw,46px);margin-top:14px;max-width:20ch">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}

  <div class="non-rte" style="margin-top:22px">{{ section.settings.text }}</div>

  {%- if section.settings.link_label != blank -%}
    <a href="{{ section.settings.link }}" class="non-btn" style="display:inline-block;margin-top:24px">
      {{ section.settings.link_label }}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
