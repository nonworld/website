<div class="non-split">
  {%- for block in section.blocks -%}
    <div class="non-split__cell" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', widths: '600,900,1200', alt: block.settings.title
        }}
      {%- endif -%}

      <div class="non-split__body">
        <div class="non-split__title">{{ block.settings.title }}</div>
        <p class="non-split__text">{{ block.settings.text }}</p>
        {%- if block.settings.link_label != blank -%}
          <a class="non-split__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Split feature",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "cell",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "cell",
        "settings": {
          "title": "Visit NONHQ",
          "text": "The world's first non-alcoholic cellar door. Tastings, tours and workshops in Cheltenham, VIC.",
          "link_label": "Book a tasting"
        }
      },
      {
        "type": "cell",
        "settings": {
          "title": "Savour the flavour",
          "text": "The NONstopper holds carbonation and freshness seven days, cold.",
          "link_label": "See the stopper"
        }
      }
    ]
  },
  "presets": [{ "name": "Split feature" }]
}
{% endschema %}

