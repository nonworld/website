{% render 'section-style', section: section %}
<div class="non-section">
  <div class="non-section__head">
    <h1 class="non-section__title">Collections</h1>
  </div>

  <div class="non-grid non-grid--3">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="non-card">
        <span class="non-card__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 800, format: 'webp' | image_tag: loading: 'lazy', alt: collection.title }}
          {%- endif -%}
        </span>
        <span class="non-card__name">{{ collection.title }}</span>
        <span class="non-card__note">{{ collection.products_count }} products</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "sans",
          "label": "Helvetica (all text)"
        },
        {
          "value": "mono",
          "label": "JetBrains Mono (all text)"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales every text size in this section together."
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the section's own spacing."
    }
  ]
}
{% endschema %}
